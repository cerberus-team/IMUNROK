# ── 구운 메시 / 지형 (.asset 바이너리) ──
#   URP 설정과 Onggojip 데이터만 예외로 포함한다.
/[Aa]ssets/**/*.asset
/[Aa]ssets/**/*.asset.meta
!/[Aa]ssets/_Project/Settings/*.asset
!/[Aa]ssets/_Project/Settings/*.asset.meta
!/[Aa]ssets/_Project/Onggojip/Data/*.asset
!/[Aa]ssets/_Project/Onggojip/Data/*.asset.meta
!/[Aa]ssets/Resources/*.asset
!/[Aa]ssets/Resources/*.asset.meta
!/[Aa]ssets/Oculus/*.asset
!/[Aa]ssets/Oculus/*.asset.meta

# ── README 용 스크린샷은 예외로 허용 ──
!/docs/
!/docs/**/*.png
!/docs/**/*.jpg
!/docs/**/*.gif

# ── 작업 백업 (다시 생기더라도 커밋되지 않게) ──
/_SceneBackup/
/[Aa]ssets/**/_bk/
/[Aa]ssets/**/_Backup/
/[Aa]ssets/_Recovery/
/[Aa]ssets/Screenshots/
/[Aa]ssets/Screenshots.meta
