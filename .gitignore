# ═════════════════════════════════════════════
# 포트폴리오 공개 설정 (2026-08-22)
#   방침: 코드·씬·프리팹·머티리얼·설정 등 "텍스트 자산"만 커밋한다.
#         3D 모델·텍스처·구운 메시 등 바이너리 아트와 기성 에셋 팩은 제외.
#   → 클론해도 씬은 그대로 열리지 않는다. README 의 안내를 따를 것.
# ═════════════════════════════════════════════

# ── 기성 에셋 팩 (재배포 불가 / 각자 임포트) ──
/[Aa]ssets/SeyeonjeongPavilion/
/[Aa]ssets/SeyeonjeongPavilion.meta
/[Aa]ssets/AllSkyFree/
/[Aa]ssets/AllSkyFree.meta
/[Aa]ssets/TombOfSilla/
/[Aa]ssets/TombOfSilla.meta
/[Aa]ssets/SUIMONO - WATER SYSTEM 2/
/[Aa]ssets/SUIMONO - WATER SYSTEM 2.meta
/[Aa]ssets/KCDF/
/[Aa]ssets/KCDF.meta
/[Aa]ssets/WaterWorks/
/[Aa]ssets/WaterWorks.meta
/[Aa]ssets/Ayo Free Toon Water/
/[Aa]ssets/Ayo Free Toon Water.meta
/[Aa]ssets/Julien Tonsuso/
/[Aa]ssets/Julien Tonsuso.meta
/[Aa]ssets/TutorialInfo/
/[Aa]ssets/TutorialInfo.meta

# ── 기성 팩 추가분 (2026-08-27) ──
#   ★.meta 차단을 푸는 순간 이 팩들이 새어나왔다.
#   지금까지는 *.png.meta 같은 확장자 규칙에 우연히 가려져 있었을 뿐이다.
#   스토어 팩은 팀원이 각자 임포트하면 GUID 가 저절로 맞는다 — 커밋하면 안 된다.
/[Aa]ssets/Idyllic Fantasy Nature/
/[Aa]ssets/Idyllic Fantasy Nature.meta
/[Aa]ssets/FlipGameDev/
/[Aa]ssets/FlipGameDev.meta
/[Aa]ssets/Eric VFX Studio/
/[Aa]ssets/Eric VFX Studio.meta
/[Aa]ssets/Fog Particles/
/[Aa]ssets/Fog Particles.meta
/[Aa]ssets/RainSnowCloudEffect/
/[Aa]ssets/RainSnowCloudEffect.meta

# ── Unity 기본 제공물 ──
#   TMP Essentials 는 각자 프로젝트가 이미 갖고 있다. 덮으면 충돌만 난다.
/[Aa]ssets/TextMesh Pro/
/[Aa]ssets/TextMesh Pro.meta

# ── 팀원 꾸러미 (원작자 브랜치가 나른다) ──
#   견우 UI. 우리가 같이 올리면 머지 때 같은 파일이 양쪽에서 올라온다.
/[Aa]ssets/IMUNROK_UI/
/[Aa]ssets/IMUNROK_UI.meta

# ── 바이너리 아트 (모델) ──
#   ★알통만 막고 .meta 는 반드시 커밋한다 (2026-08-27).
#   .meta 가 빠지면 GUID 가 새로 생겨 팀원 쪽에서 참조가 통째로 죽는다.
*.fbx
*.blend
*.blend1
*.obj
*.dae
*.max
*.mb
*.ma

# ── 바이너리 아트 (텍스처) ──
*.png
*.jpg
*.jpeg
*.tga
*.psd
*.tif
*.tiff
*.exr
*.hdr
*.cubemap

# ── 바이너리 아트 (오디오·폰트·패키지) ──
*.wav
*.mp3
*.ogg
*.aif
*.aiff
*.ttf
*.otf
*.unitypackage
*.unitypackage.meta

# ── 구운 메시 / 지형 (.asset 바이너리) ──
#   URP 설정과 Onggojip 데이터만 예외로 포함한다.
/[Aa]ssets/**/*.asset
!/[Aa]ssets/_Project/Settings/*.asset
!/[Aa]ssets/_Project/Onggojip/Data/*.asset
!/[Aa]ssets/Resources/*.asset
!/[Aa]ssets/Oculus/*.asset

# ── README 용 스크린샷은 예외로 허용 ──
!/docs/
!/docs/**/*.png
!/docs/**/*.jpg
!/docs/**/*.gif

# ── 작업 백업 (다시 생기더라도 커밋되지 않게) ──
/_SceneBackup/
/[Aa]ssets/**/_bk/
/[Aa]ssets/**/_Backup/
/[Aa]ssets/_Recovery/
/[Aa]ssets/Screenshots/
/[Aa]ssets/Screenshots.meta

# 팀 인수인계 임시 폴더 (커밋 대상 아님)
/_TeamHandoff/
.gitignore.bak
.gitignore.before-meta-fix
/.codex/

# ── 작업 중 만든 잔여 파일 ──
/[Aa]ssets/_Recovery.meta
/_planetpick.txt
/_us.txt
/oisamun_del.txt
/unused.txt
