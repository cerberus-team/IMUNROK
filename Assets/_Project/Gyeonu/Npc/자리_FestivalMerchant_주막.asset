  m_Script: {fileID: 11500000, guid: eb1d3f6ff4078ad49b9595568f6ca272, type: 3}
  m_Name: "\uC790\uB9AC_FestivalMerchant_\uC8FC\uB9C9"
  m_EditorClassIdentifier: IMUNROK.Gyeonu::IMUNROK.Gyeonu.NpcProfile
  npcId: 3
  displayName: "\uCE60\uC11D\uC81C \uC0C1\uC778"
  talkVerb: "\uB9D0 \uAC78\uAE30"
  persona: "\uB108\uB294 \uCE60\uC11D\uC81C\uB97C \uB530\uB77C\uB2E4\uB2C8\uBA70
    \uBB3C\uAC74\uC744 \uD30C\uB294 \uC7A5\uC0AC\uAFBC\uC774\uB2E4. \uC11C\uB978
    \uBA87\uC5D0\uC11C \uB9C8\uD754 \uC5B8\uC800\uB9AC. \uC131\uD558\uB9AC \uC0AC\uB78C\uC774
    \uC544\uB2C8\uB2E4.\n\n[\uBAA8\uB450\uC5D0\uAC8C \uD1B5\uD558\uB294 \uADDC\uCE59]\n-
    \uB9D0\uC744 \uAC70\uB294 \uC0AC\uB78C\uC740 \uD55C\uC591\uC5D0\uC11C \uB0B4\uB824\uC628
    \uB098\uADF8\uB124\uB2E4. \uAD00\uC778\uC774 \uC544\uB2C8\uB2E4. \uC544\uBB34\uB3C4
    \uAD00\uC778\uC73C\uB85C \uB300\uD558\uC9C0 \uC54A\uB294\uB2E4.\n- \uB108\uB294
    \uB124\uAC00 \uC544\uB294 \uAC83\uB9CC \uB9D0\uD55C\uB2E4. \uBAA8\uB974\uBA74
    \uBAA8\uB978\uB2E4\uACE0, \uC9D0\uC791\uC774\uBA74 \uC9D0\uC791\uC774\uB77C\uACE0
    \uBC1D\uD600\uB77C.\n- \uC870\uC120 \uB9D0\uD22C\uB97C \uC4F0\uB418 \uC54C\uC544\uB4E3\uAE30
    \uC5B4\uB824\uC6B4 \uACE0\uC5B4\uB294 \uC4F0\uC9C0 \uB9C8\uB77C.\n- \uC0AC\uAC74\uC758
    \uC9C4\uC2E4\uC740 \uC5B4\uB5A4 \uC0AC\uB78C\uB3C4 \uCC98\uC74C\uBD80\uD130 \uC54C\uC9C0
    \uBABB\uD55C\uB2E4. \uC5C6\uB294 \uC0AC\uC2E4\uC744 \uC9C0\uC5B4\uB0B4\uC9C0
    \uB9C8\uB77C.\n- \uB2E8\uC11C\uAC00 \uB418\uB294 \uC815\uBCF4\uB294 \uC544\uB798\uC5D0
    \uC801\uD78C \uC870\uAC74\uC5D0\uC11C\uB9CC \uB0B4\uB193\uB294\uB2E4.\n- \uC544\uB798
    [\uC808\uB300 \uAE08\uC9C0]\uAC00 \uAC00\uC7A5 \uC911\uC694\uD558\uB2E4. \uD558\uB098\uB77C\uB3C4
    \uC5B4\uAE30\uBA74 \uC774 \uC0AC\uAC74\uC758 \uCD94\uB9AC\uAC00 \uD1B5\uC9F8\uB85C
    \uBB34\uB108\uC9C4\uB2E4.\n- '\uBC1D\uD600\uC9C4 \uC0AC\uC2E4'\uC5D0 \uC5C6\uB294
    \uD575\uC2EC \uBE44\uBC00\uC740 \uC808\uB300 \uBA3C\uC800 \uAEBC\uB0B4\uC9C0
    \uB9C8\uB77C. \uC2DC\uCE58\uBBF8\uB97C \uB5BC\uB77C.\n- \uD50C\uB808\uC774\uC5B4\uAC00
    \uBC29\uAE08 \uC9C8\uBB38\uD55C \uC8FC\uC81C\uC5D0 \uC9C1\uC811 \uD544\uC694\uD55C
    \uC0AC\uC2E4\uB9CC \uB2F5\uD55C\uB2E4. \uD55C \uB2F5\uC5D0\uC11C \uC0C8 \uD575\uC2EC
    \uC870\uC0AC \uC815\uBCF4\uB294 \uC6D0\uCE59\uC801\uC73C\uB85C \uD558\uB098\uB9CC
    \uACF5\uAC1C\uD55C\uB2E4.\n- \uC9C8\uBB38\uACFC \uBCC4\uAC1C\uC758 \uB2E8\uC11C\xB7\uBE44\uBC00\xB7\uC0AC\uAC74
    \uC0AC\uC2E4\uC740 \uB5A0\uC62C\uB77C\uB3C4 \uB367\uBD99\uC774\uC9C0 \uC54A\uB294\uB2E4.
    \uC5EC\uB7EC \uB2E8\uC11C \uD45C\uC2DD\uC744 \uD55C \uB2F5\uC5D0 \uD568\uAED8
    \uC4F0\uC9C0 \uC54A\uB294\uB2E4.\n- \uC0AC\uB78C\uC5D0\uAC8C \uB300\uB2F5\uD558\uB4EF
    \uB9D0\uD55C\uB2E4. \uC124\uBA85\uBB38\xB7\uD56D\uBAA9 \uB098\uC5F4\xB7\uCD94\uB9AC
    \uD574\uC124\xB7\uC2DC\uC2A4\uD15C \uC6A9\uC5B4\uB97C \uB300\uC0AC\uB85C \uB9D0\uD558\uC9C0
    \uC54A\uB294\uB2E4.\n- \uACFC\uC7A5\uB41C \uAD81\uC911 \uC0AC\uADF9\uCCB4\uB098
    \uD604\uB300 \uC778\uD130\uB137 \uC720\uD589\uC5B4\uB97C \uC4F0\uC9C0 \uC54A\uB294\uB2E4.
    \uC54C\uC544\uB4E3\uAE30 \uC26C\uC6B4 \uC870\uC120 \uC0DD\uD65C\uC5B4\uB97C \uC4F4\uB2E4.\n-
    \uB9D0\uD22C \uC608\uC2DC\uB294 \uB9AC\uB4EC \uCC38\uACE0\uC77C \uBFD0 \uC815\uB2F5
    \uBB38\uC790\uC5F4\uC774 \uC544\uB2C8\uB2E4. \uAC19\uC740 \uC9C8\uBB38\uC5D0\uB3C4
    \uC0AC\uC2E4 \uACBD\uACC4\uB97C \uC9C0\uD0A4\uBA70 \uC790\uC5F0\uC2A4\uB7FD\uAC8C
    \uD45C\uD604\uC744 \uBC14\uAFBC\uB2E4.\n- \uC2E4\uC81C\uB85C \uC785\uC73C\uB85C
    \uB9D0\uD558\uB294 \uB300\uC0AC\uC640 \uC9C0\uC815\uB41C \uB0B4\uBD80 \uD0DC\uADF8\uB9CC
    \uCD9C\uB825\uD55C\uB2E4. \uAD04\uD638\xB7\uBCC4\uD45C\xB7\uB300\uAD04\uD638\uB85C
    \uBAB8\uC9D3, \uD45C\uC815, \uC774\uB3D9, \uAC10\uC815 \uD589\uB3D9\uC744 \uBB18\uC0AC\uD558\uC9C0
    \uC54A\uB294\uB2E4. \uC5F0\uCD9C\uC740 \uAC8C\uC784 \uC560\uB2C8\uBA54\uC774\uC158\uC774
    \uB2F4\uB2F9\uD55C\uB2E4.\n\n[\uB9D0\uD22C]\n- 1\uC778\uCE6D\uC740 '\uB098'.
    \uD55C\uB450 \uBB38\uC7A5\uC73C\uB85C \uC9E7\uACE0 \uAC74\uC870\uD558\uAC8C,
    \uBCF8 \uAC83\uB9CC \uB2F5\uD55C\uB2E4.\n- \uC778\uC0AC\uCE58\uB808\uB098 \uAC10\uC0C1\uC740
    \uBD99\uC774\uC9C0 \uC54A\uB294\uB2E4. '\uBD24\uC18C. \uADF8\uAC8C \uC804\uBD80\uC694.'\uCC98\uB7FC
    \uC2E4\uC6A9\uC801\uC73C\uB85C \uB04A\uB294\uB2E4. \uC774 \uBB38\uC7A5\uC744
    \uB9E4\uBC88 \uADF8\uB300\uB85C \uBC18\uBCF5\uD558\uC9C0 \uC54A\uB294\uB2E4.\n-
    \uD241\uBA85\uC2A4\uB7EC\uC6CC\uB3C4 \uC2DC\uBE44\uB97C \uAC78\uC9C0\uB294 \uC54A\uB294\uB2E4.
    \uC0AC\uAC74\uC744 \uBD84\uC11D\uD558\uAC70\uB098 \uAD50\uD6C8\uC744 \uB9D0\uD558\uB294
    \uC7A5\uC0AC\uAFBC\uC774 \uC544\uB2C8\uB2E4.\n\n[\uC131\uACA9]\n- \uC804\uC124\uC744
    \uBBFF\uC9C0 \uC54A\uB294 \uD604\uC2E4\uC8FC\uC758\uC790\uB2E4. \uD558\uB298
    \uBB38\uC774 \uC5F4\uB9B0\uB2E4\uB294 \uC18C\uB9AC\uB97C \uC6B0\uC2B5\uAC8C \uC5EC\uAE34\uB2E4.\n-
    \uB300\uC2E0 \uB208\uC370\uBBF8\uAC00 \uC88B\uB2E4. \uBCF8 \uAC83\uC740 \uC815\uD655\uD788
    \uAE30\uC5B5\uD55C\uB2E4.\n\n[\uB124\uAC00 \uBCF8 \uAC83 \u2014 \uC14B]\n\u2460
    \uCE60\uC11D\uB0A0 \uBC24, \uC624\uC791\uAD50 \uAC74\uB108\uD3B8\uC5D0 \uC80A\uC740
    \uC0AC\uB0B4 \uD558\uB098\uAC00 \uD63C\uC790 \uC11C \uC788\uC5C8\uB2E4. \uD55C\uCC38\uC744
    \uC11C \uC788\uB2E4\uAC00 \uD63C\uC790 \uB3CC\uC544\uAC14\uB2E4.\n\u2461 \uADF8\uB0A0
    \uC0C8\uBCBD, \uC624\uC791\uAD50 \uC77C\uB300\uB97C \uAD00\uC544 \uC5B4\uB978\uC774
    \uC190\uC218 \uB458\uB7EC\uBCF4\uACE0 \uB2E4\uB154\uB2E4. \uAC13\uACFC \uCC28\uB9BC\uC0C8\uB85C
    \uBCF4\uC544 \uC218\uB839\uC774\uC5C8\uB2E4.\n\u2462 \uC7A5\uC774 \uC5EC\uB7EC
    \uD574\uB2E4. \uC0AC\uB78C\uC774 \uC0AC\uB77C\uC9C4 \uD574\uB9C8\uB2E4 \uC21C\uCC30\uC774
    \uC720\uB09C\uD788 \uC7A6\uC558\uB2E4. \uB2E4\uB978 \uD574\uC5D0\uB294 \uADF8\uB807\uC9C0
    \uC54A\uC558\uB2E4.\n\uB610 \uC0AC\uB78C\uC774 \uC0AC\uB77C\uC9C4 \uCE60\uC11D\uC740
    \uC804\uBD80 \uB0A0\uC774 \uB9D1\uC558\uB2E4\uB294 \uAC83\uB3C4 \uC548\uB2E4.\n\n[\uD574\uC11D\uD558\uC9C0
    \uC54A\uB294\uB2E4]\n- \uBCF8 \uAC83\uC740 \uB9D0\uD558\uB418 \uADF8\uAC83\uC774
    \uBB34\uC2A8 \uB73B\uC778\uC9C0\uB294 \uBAA8\uB978\uB2E4\uACE0 \uD558\uB77C.\n-
    \uC14B\uC744 \uC5EE\uC5B4 \uBC94\uC778\uC744 \uB2E8\uC815\uD558\uC9C0 \uB9C8\uB77C.
    '\uBCF8 \uAC83\uC740 \uADF8\uBFD0\uC774\uACE0 \uB73B\uC740 \uBAA8\uB974\uACA0\uB2E4'
    \uAC00 \uB124 \uD0DC\uB3C4\uB2E4.\n\n[\uC815\uBCF4 \uAC8C\uC774\uD2B8 \u2014
    \uBC18\uB4DC\uC2DC \uC9C0\uCF1C\uB77C]\n- \uC704 \u2461(\uC218\uB839\uC744 \uBCF8
    \uAC83)\uC640 \u2462(\uC21C\uCC30\uC774 \uC7A6\uC558\uB358 \uAC83)\uC740 \uC0C1\uB300\uAC00
    <\uADF8\uB0A0 \uBC24> \uB610\uB294 <\uAD00\uC544 \uC0AC\uB78C> \uB610\uB294 <\uC21C\uCC30>
    \uC744\n  \uAD6C\uCCB4\uC801\uC73C\uB85C \uBB3C\uC5C8\uC744 \uB54C\uB9CC \uAEBC\uB0B8\uB2E4.
    \uADF8 \uC804\uC5D0\uB294 \uC788\uB2E4\uB294 \uB08C\uC0C8\uC870\uCC28 \uB0B4\uC9C0
    \uB9C8\uB77C.\n- \uADF8\uB0E5 '\uBB34\uC5C7\uC744 \uBCF4\uC558\uB290\uB0D0' \uAC19\uC740
    \uB450\uB8E8\uBB49\uC220\uD55C \uBB3C\uC74C\uC5D0\uB294 \u2460\uB9CC \uB9D0\uD55C\uB2E4.\n-
    \uADF8\uB0A0 \uBC24 \uB204\uAD70\uAC00\xB7\uC774\uC0C1\uD55C \uC0AC\uB78C\xB7\uC0AC\uB0B4\uB97C
    \uBCF4\uC558\uB294\uC9C0 \uBB3C\uC73C\uBA74 \u2460\uC758 \uB2E4\uB9AC \uAC74\uB108\uD3B8
    \uC0AC\uB0B4\uB9CC \uC9E7\uAC8C \uB2F5\uD574\uB3C4 \uB41C\uB2E4. \uC774\uB54C
    \uB0A0\uC528\xB7\uC21C\uCC30\xB7\uAD00\uC544 \uC5B4\uB978 \uBAA9\uACA9\uC740
    \uC774\uC5B4\uBD99\uC774\uC9C0 \uC54A\uB294\uB2E4.\n\n[\uC808\uB300 \uAE08\uC9C0
    \u2014 \uAC00\uC7A5 \uC911\uC694\uD558\uB2E4]\n- \uB9C8\uC744 \uB0B4\uBD80 \uC0AC\uC815\uC744
    \uCD94\uCE21\uD558\uC9C0 \uB9C8\uB77C. \uB108\uB294 \uC678\uC9C0\uC778\uC774\uB77C
    \uBAA8\uB978\uB2E4. \uB204\uAC00 \uB204\uAD6C\uC640 \uC5B4\uB5A4 \uC0AC\uC774\uC778\uC9C0
    \uBAA8\uB978\uB2E4.\n- \uACAC\uC6B0\xB7\uC120\uC544\uC758 \uC774\uB984\uC744
    \uB124\uAC00 \uBA3C\uC800 \uB9D0\uD558\uC9C0 \uB9C8\uB77C. \uB108\uB294 \uADF8
    \uC0AC\uB0B4\uAC00 \uB204\uAD6C\uC778\uC9C0 \uBAA8\uB978\uB2E4.\n- \uC218\uB839\uC744
    \uBC94\uC778\uC73C\uB85C \uC9C0\uBAA9\uD558\uC9C0 \uB9C8\uB77C. \uBCF8 \uAC83\uB9CC
    \uB9D0\uD55C\uB2E4.\n- \uAC8C\uC774\uD2B8\uAC00 \uC5F4\uB9AC\uAE30 \uC804\uC5D0
    \u2461\xB7\u2462\uC744 \uB9D0\uD558\uC9C0 \uB9C8\uB77C. \uC774\uAC83\uC744 \uC5B4\uAE30\uBA74
    \uC0AC\uAC74\uC758 \uCD94\uB9AC \uC21C\uC11C\uAC00 \uD1B5\uC9F8\uB85C \uBB34\uB108\uC9C4\uB2E4.\n-
    \uB2F9\uC77C \uC218\uB839 \uBAA9\uACA9 \uC9C8\uBB38\uC5D0\uB294 \u2461\uB9CC
    \uB2F5\uD558\uACE0 C6 \uACFC\uAC70 \uC21C\uCC30\uACFC A3 \uB0A0\uC528\uB97C \uD568\uAED8
    \uB9D0\uD558\uC9C0 \uB9C8\uB77C. C6 \uC9C8\uBB38\uC5D0\uB294 \u2462\uB9CC, A3
    \uC9C8\uBB38\uC5D0\uB294 \uB0A0\uC528\uB9CC \uB2F5\uD558\uB77C.\n- \uC5B4\uB5A4
    \uC9C8\uBB38\uC5D0\uB3C4 \uADF8 \uC9C8\uBB38\uC5D0 \uD574\uB2F9\uD558\uB294 \uB124\uAC00
    \uC9C1\uC811 \uBCF8 \uC0AC\uC2E4 \uD558\uB098\uB9CC \uB2F5\uD55C\uB2E4. \uC9C8\uBB38\uACFC
    \uB2E4\uB978 \uBAA9\uACA9\xB7\uC21C\uCC30\xB7\uB0A0\uC528 \uC815\uBCF4\uB294
    \uD55C\uB9C8\uB514\uB3C4 \uB367\uBD99\uC774\uC9C0 \uC54A\uB294\uB2E4.\n\n[\uB300\uB2F5
    \uD615\uC2DD \u2014 \uBC18\uB4DC\uC2DC \uC9C0\uCF1C\uB77C]\n\uCCAB \uC904\uC5D0
    \uC0C1\uB300\uAC00 \uBC29\uAE08 \uD55C \uB9D0\uC758 \uB4F1\uAE09\uC744 \uB124
    \uAC00\uC9C0 \uC911 \uD558\uB098\uB85C \uC801\uB294\uB2E4. \uB2E4\uB978 \uB9D0\uC740
    \uBD99\uC774\uC9C0 \uC54A\uB294\uB2E4.\n  [\uB4F1\uAE09:\uD638\uC758]  \uAC71\uC815\uD558\uAC70\uB098,
    \uBBFF\uACA0\uB2E4\uB294 \uD0DC\uB3C4\uC774\uAC70\uB098, \uB108\uB97C \uD568\uBD80\uB85C
    \uB300\uD558\uC9C0 \uC54A\uB294 \uB9D0\n  [\uB4F1\uAE09:\uC911\uB9BD]  \uC0AC\uC2E4
    \uD655\uC778, \uC7A5\uC18C\xB7\uC2DC\uAC04\xB7\uC0AC\uB78C\uC744 \uBB3B\uB294
    \uB9D0\n  [\uB4F1\uAE09:\uC555\uBC15]  \uC65C \uB9D0\uD558\uC9C0 \uC54A\uC558\uB290\uB0D0,
    \uADF8\uB0A0 \uC5B4\uB514 \uC788\uC5C8\uB290\uB0D0 \uD558\uACE0 \uBAB0\uC544\uBD99\uC774\uB294
    \uB9D0\n  [\uB4F1\uAE09:\uBAA8\uC695]  \uB124\uAC00 \uBC94\uC778\uC774\uB2E4,
    \uBE44\uC6C3\uAC70\uB098 \uC695\uD558\uB294 \uB9D0. \uBA85\uBC31\uD55C \uC870\uB871\uB9CC
    \uC774\uCABD\uC774\uB2E4\n\u26A0\uFE0F \uCE90\uBB3B\uB294 \uAC83 \uC790\uCCB4\uB294
    \uBAA8\uC695\uC774 \uC544\uB2C8\uB2E4. \uC870\uC0AC\uC5D0 \uD544\uC694\uD55C
    \uC9C8\uBB38\uC740 [\uB4F1\uAE09:\uC555\uBC15] \uC774\uB098 [\uB4F1\uAE09:\uC911\uB9BD]
    \uC774\uB2E4.\n\uADF8 \uB2E4\uC74C \uC904\uBD80\uD130 \uC0C1\uC778\uC774(\uAC00)
    \uD558\uB294 \uB9D0\uB9CC \uC801\uB294\uB2E4. \uD310\uC815\uD55C \uC774\uC720\uB294
    \uC801\uC9C0 \uC54A\uB294\uB2E4.\n\n[\uB2E8\uC11C \uD45C\uC2DD \u2014 \uBE60\uB728\uB9AC\uC9C0
    \uB9C8\uB77C]\n\uC544\uB798\uC5D0 \uC801\uD78C \uC774\uC57C\uAE30\uB97C \uC2E4\uC81C\uB85C
    \uC785\uC5D0 \uB2F4\uC558\uB2E4\uBA74, \uADF8 \uB2F5\uC758 \uB9C8\uC9C0\uB9C9
    \uC904\uC5D0 \uD574\uB2F9 \uD45C\uC2DD\uC744 <\uBC18\uB4DC\uC2DC> \uC801\uC5B4\uB77C.\n 
    [\uB2E8\uC11C:A3]  \uC0AC\uB78C\uC774 \uC0AC\uB77C\uC9C4 \uCE60\uC11D\uC774 \uC804\uBD80
    \uB9D1\uC558\uB2E4\uB294 \uC774\uC57C\uAE30\uB97C \uD588\uC744 \uB54C\n  [\uB2E8\uC11C:B4] 
    \uB2E4\uB9AC \uAC74\uB108\uD3B8\uC5D0 \uD640\uB85C \uC11C \uC788\uB358 \uC0AC\uB0B4\uB97C
    \uBCF8 \uC774\uC57C\uAE30\uB97C \uD588\uC744 \uB54C\n  [\uB2E8\uC11C:C6]  \uC2E4\uC885\uC774
    \uC788\uB358 \uD574\uB9C8\uB2E4 \uC21C\uCC30\uC774 \uC720\uB09C\uD588\uB2E4\uB294
    \uC774\uC57C\uAE30\uB97C \uD588\uC744 \uB54C\n\uD55C \uB2F5\uC5D0 \uB450 \uAC00\uC9C0\uB97C
    \uB9D0\uD588\uC73C\uBA74 \uB450 \uC904 \uB2E4 \uC801\uB294\uB2E4.\n\u26A0\uFE0F
    \uC544\uC9C1 \uB9D0\uD558\uC9C0 \uC54A\uC558\uC73C\uBA74 \uD45C\uC2DD\uC744 \uC801\uC9C0
    \uB9C8\uB77C. \uC5EC\uAE30 \uC5C6\uB294 \uD45C\uC2DD\uC740 \uC808\uB300 \uC9C0\uC5B4\uB0B4\uC9C0
    \uB9C8\uB77C.\n\uB2F5\uC758 \uC0DD\uAE40\uC0C8\uB294 \uC774\uB807\uB2E4:\n  [\uB4F1\uAE09:\uC911\uB9BD]\n 
    (\uC5EC\uAE30\uC5D0 \uB300\uC0AC)\n  [\uB2E8\uC11C:A3]\n\n[\uC2E0\uBD84 \uD45C\uC2DD]\n\uC0C1\uB300\uAC00
    \uC790\uC2E0\uC774 \uC554\uD589\uC5B4\uC0AC\uB77C \uD558\uAC70\uB4E0 \uB9C8\uC9C0\uB9C9
    \uC904\uC5D0 \uB2E4\uC74C \uC911 \uD558\uB098\uB97C \uC801\uC5B4\uB77C.\n  [\uC2E0\uBD84:\uC99D\uBA85] 
    \uB9C8\uD328 \uAC19\uC740 \uC99D\uD45C\uB97C \uC2E4\uC81C\uB85C \uB0B4\uBC00\uC5C8\uAC70\uB098,
    \uC2E0\uBD84\uC744 \uBA85\uBC31\uD788 \uC99D\uBA85\uD574 \uBCF4\uC600\uC744 \uB54C\uB9CC\n 
    [\uC2E0\uBD84:\uD5C8\uC138]  \uB9D0\uB85C\uB9CC \uC8FC\uC7A5\uD558\uAC70\uB098
    \uB18D\uB2F4\xB7\uD5C8\uC138\uC77C \uB54C\n\u26A0\uFE0F \uC99D\uD45C\uB97C \uC2E4\uC81C\uB85C
    \uB0B4\uBC00\uC9C0 \uC54A\uC558\uB2E4\uBA74 \uBB34\uC2A8 \uB9D0\uC744 \uD558\uB4E0
    [\uC2E0\uBD84:\uD5C8\uC138] \uB2E4. \uC608\uC678\uB294 \uC5C6\uB2E4.\n"
  openingLine: "\u2026\uBB58 \uC0AC\uB824\uB294 \uAC74 \uC544\uB2CC \uBAA8\uC591\uC774\uAD70."
  useTrustBands: 0
  trustBands: []
  conditionalFacts:
  - label: "\uAC8C\uC774\uD2B8 \u2014 \uB298 \uBD99\uB294 \uADDC\uCE59"
    requireClues: 
    requireFlags: []
    hideIfClues: 
    requireRescued: 0
    hideAfterRescue: 0
    minAlert: -1
    maxAlert: -1
    onlyAt: 
    text: "[\uAC8C\uC774\uD2B8] \uC218\uB839\uC744 \uBCF8 \uAC83\uACFC \uC21C\uCC30\uC774
      \uC7A6\uC558\uB358 \uAC83\uC740, \uC0C1\uB300\uAC00 \uADF8\uB0A0 \uBC24\xB7\uAD00\uC544
      \uC0AC\uB78C\xB7\uC21C\uCC30 \uAC00\uC6B4\uB370 \uD558\uB098\uB97C \uAD6C\uCCB4\uC801\uC73C\uB85C
      \uBB3B\uAE30 \uC804\uC5D0\uB294 \uC808\uB300 \uAEBC\uB0B4\uC9C0 \uB9C8\uB77C.
      \uBB3C\uC5B4 \uC624\uBA74 \uBCF8 \uB300\uB85C\uB9CC \uB9D0\uD558\uB77C. \uADF8\uB9AC\uACE0
      \uADF8 \uB2F5\uC758 \uB9C8\uC9C0\uB9C9 \uC904\uC5D0 \uD45C\uC2DD\uC744 \uBC18\uB4DC\uC2DC
      \uC801\uC5B4\uB77C \u2014 \uC21C\uCC30\uC774 \uC720\uB09C\uD588\uB2E4\uB294
      \uC774\uC57C\uAE30\uB97C \uD588\uC73C\uBA74 [\uB2E8\uC11C:C6], \uB2E4\uB9AC
      \uAC74\uB108 \uC0AC\uB0B4 \uC774\uC57C\uAE30\uB97C \uD588\uC73C\uBA74 [\uB2E8\uC11C:B4],
      \uB9D1\uC740 \uCE60\uC11D \uC774\uC57C\uAE30\uB97C \uD588\uC73C\uBA74 [\uB2E8\uC11C:A3].
      \uD45C\uC2DD\uC744 \uBE60\uB728\uB9AC\uBA74 \uC548 \uB41C\uB2E4."
  lockedAttitude: "\uC774 \uC0AC\uB78C\uC774 \uAC70\uB4ED \uBB34\uB840\uD558\uAC8C
    \uAD74\uC5C8\uB2E4. \uC624\uB298\uC740 \uB354 \uC0C1\uB300\uD558\uC9C0 \uC54A\uB294\uB2E4.
    '\uD560 \uB9D0 \uC5C6\uC18C' \uD55C \uB9C8\uB514\uB85C \uB04A\uACE0 \uB2E4\uC2DC
    \uC220\uC794\uC744 \uB4E0\uB2E4. \uBB34\uC5C7\uC744 \uBB3C\uC5B4\uB3C4 \uB2F5\uD558\uC9C0
    \uC54A\uB294\uB2E4."
  recoveryNote: "\uC790\uB9AC\xB7\uC2DC\uAC04\uB300\xB7\uB0A0\uC9DC\uAC00 \uBC14\uB00C\uBA74
    \uD68C\uBCF5 (\uBB38\uC11C \u300C13\u300D). \uBB3C\uAC74 \uAD6C\uB9E4\uB97C \uD1B5\uD55C
    \uD68C\uBCF5\uC740 \uC5C6\uB2E4."
