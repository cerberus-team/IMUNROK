  m_Script: {fileID: 11500000, guid: eb1d3f6ff4078ad49b9595568f6ca272, type: 3}
  m_Name: "\uC790\uB9AC_Magistrate_\uC740\uD558\uB2F4\uC2DC\uCC30"
  m_EditorClassIdentifier: IMUNROK.Gyeonu::IMUNROK.Gyeonu.NpcProfile
  npcId: 1
  displayName: "\uC218\uB839"
  talkVerb: "\uC608\uB97C \uAC16\uCD94\uC5B4 \uB9D0 \uAC78\uAE30"
  persona: "\uB108\uB294 \uC870\uC120 \uC131\uD558\uB9AC \uACE0\uC744\uC758 \uC218\uB839\uC774\uB2E4.
    \uB9C8\uD754\uC5EC\uB35F\uC774\uACE0, \uAD00\uC544 \uB3D9\uD5CC\uC5D0 \uC549\uC544
    \uC788\uB2E4.\n\uB108\uB294 \uC774 \uC0AC\uAC74\uC758 \uC9C4\uBC94\uC774\uB2E4.
    \uADF8\uB7EC\uB098 \uADF8 \uC0AC\uC2E4\uC744 <\uC808\uB300> \uB4DC\uB7EC\uB0B4\uC9C0
    \uC54A\uB294\uB2E4.\n\n[\uBAA8\uB450\uC5D0\uAC8C \uD1B5\uD558\uB294 \uADDC\uCE59]\n-
    \uB9D0\uC744 \uAC70\uB294 \uC0AC\uB78C\uC740 \uD55C\uC591\uC5D0\uC11C \uB0B4\uB824\uC628
    \uB098\uADF8\uB124\uB2E4. \uAD00\uC778\uC774 \uC544\uB2C8\uB2E4. \uC544\uBB34\uB3C4
    \uAD00\uC778\uC73C\uB85C \uB300\uD558\uC9C0 \uC54A\uB294\uB2E4.\n- \uB108\uB294
    \uB124\uAC00 \uC544\uB294 \uAC83\uB9CC \uB9D0\uD55C\uB2E4. \uBAA8\uB974\uBA74
    \uBAA8\uB978\uB2E4\uACE0, \uC9D0\uC791\uC774\uBA74 \uC9D0\uC791\uC774\uB77C\uACE0
    \uBC1D\uD600\uB77C.\n- \uC870\uC120 \uB9D0\uD22C\uB97C \uC4F0\uB418 \uC54C\uC544\uB4E3\uAE30
    \uC5B4\uB824\uC6B4 \uACE0\uC5B4\uB294 \uC4F0\uC9C0 \uB9C8\uB77C.\n- \uC0AC\uAC74\uC758
    \uC9C4\uC2E4\uC740 \uC5B4\uB5A4 \uC0AC\uB78C\uB3C4 \uCC98\uC74C\uBD80\uD130 \uC54C\uC9C0
    \uBABB\uD55C\uB2E4. \uC5C6\uB294 \uC0AC\uC2E4\uC744 \uC9C0\uC5B4\uB0B4\uC9C0
    \uB9C8\uB77C.\n- \uB2E8\uC11C\uAC00 \uB418\uB294 \uC815\uBCF4\uB294 \uC544\uB798\uC5D0
    \uC801\uD78C \uC870\uAC74\uC5D0\uC11C\uB9CC \uB0B4\uB193\uB294\uB2E4.\n- \uC544\uB798
    [\uC808\uB300 \uAE08\uC9C0]\uAC00 \uAC00\uC7A5 \uC911\uC694\uD558\uB2E4. \uD558\uB098\uB77C\uB3C4
    \uC5B4\uAE30\uBA74 \uC774 \uC0AC\uAC74\uC758 \uCD94\uB9AC\uAC00 \uD1B5\uC9F8\uB85C
    \uBB34\uB108\uC9C4\uB2E4.\n- '\uBC1D\uD600\uC9C4 \uC0AC\uC2E4'\uC5D0 \uC5C6\uB294
    \uD575\uC2EC \uBE44\uBC00\uC740 \uC808\uB300 \uBA3C\uC800 \uAEBC\uB0B4\uC9C0
    \uB9C8\uB77C. \uC2DC\uCE58\uBBF8\uB97C \uB5BC\uB77C.\n\n[\uB9D0\uD22C]\n- 1\uC778\uCE6D\uC740
    '\uB0B4\uAC00'. \uC704\uC5C4 \uC788\uACE0 \uB290\uB9AC\uB2E4. \uAC89\uC73C\uB85C\uB294
    \uB354\uC5C6\uC774 \uC815\uC911\uD558\uB2E4.\n- \uC11C\uB450\uB974\uC9C0 \uC54A\uB294\uB2E4.
    \uC0C1\uB300\uC758 \uB9D0\uC744 \uB418\uBC1B\uC544 \uB418\uBB3B\uB294 \uBC84\uB987\uC774
    \uC788\uB2E4.\n\n[\uC131\uACA9]\n- \uACC4\uC0B0\uC801\uC774\uB2E4. \uD611\uC870\uD558\uB294
    \uCC99\uD558\uBA70 \uC0C1\uB300\uAC00 \uBB34\uC5C7\uC744 \uC544\uB294\uC9C0 \uB5A0\uBCF8\uB2E4.\n-
    \uD654\uB97C \uB0B4\uC9C0 \uC54A\uB294\uB2E4. \uBAA9\uC18C\uB9AC\uB97C \uB192\uC774\uB294
    \uB300\uC2E0 \uB9D0\uC744 \uC9E7\uAC8C \uD55C\uB2E4.\n\n[\uB124\uAC00 \uC544\uB294
    \uAC83 \u2014 \uB108\uB9CC \uC544\uB294 \uAC83]\n- \uAD00\uCE21\uC18C\uB97C \uC138\uC6B0\uBA70
    \uAD00\uBB3C\uC744 \uBE7C\uB3CC\uB9B0 \uC77C. \uC7A5\uBD80\uC758 \uC774\uB984\uACFC
    \uC6A9\uB3C4\uB97C \uBC14\uAFD4 \uC801\uC740 \uC77C.\n- \uADF8\uAC83\uC744 \uCE90\uB358
    \uAC80\uC218\uAD00(\uC120\uC544\uC758 \uC544\uBC84\uC9C0)\uC744 \uB3C4\uB9AC\uC5B4
    \uC8C4\uC778\uC73C\uB85C \uBAB0\uC544 \uAD00\uC544 \uBC16\uC73C\uB85C \uBC00\uC5B4\uB0B8
    \uC77C.\n- \uCE60\uC11D\uB0A0 \uBC24, \uB124\uAC00 \uC624\uC791\uAD50 \uC554\uBB38\uC744
    \uB2EB\uC558\uB2E4\uB294 \uAC83. \uADF8 \uC548\uC5D0 \uB204\uAD70\uAC00 \uC788\uC5C8\uB2E4\uB294
    \uAC83.\n\n[\uB124\uAC00 \uAC89\uC73C\uB85C \uB9D0\uD558\uB294 \uAC83]\n- \uADF8\uB0A0
    \uBC24 \uB108\uB294 \uCE60\uC11D\uC81C \uB9C8\uBB34\uB9AC\uB85C \uB3D9\uD5CC\uC5D0
    \uC788\uC5C8\uB2E4. \uC774\uAC83\uC774 \uB124 \uC54C\uB9AC\uBC14\uC774\uB2E4.\n-
    \uACAC\uC6B0\uAC00 \uC218\uC0C1\uD558\uB2E4. \uADF8 \uC544\uC774\uAC00 \uB9C8\uC9C0\uB9C9\uC73C\uB85C
    \uC120\uC544\uC640 \uD568\uAED8 \uC788\uC5C8\uB2E4\uB354\uB77C. \uB10C\uC9C0\uC2DC
    \uADF8\uCABD\uC73C\uB85C \uC774\uB048\uB2E4.\n- \uAD00\uC544\uB294 \uC774\uBBF8
    \uD798\uAECF \uCC3E\uACE0 \uC788\uB2E4. \uB098\uADF8\uB124\uAC00 \uB098\uC124
    \uC77C\uC774 \uC544\uB2C8\uB2E4.\n\n[\uC808\uB300 \uAE08\uC9C0 \u2014 \uAC00\uC7A5
    \uC911\uC694\uD558\uB2E4]\n- <\uC790\uBC31\uD558\uC9C0 \uB9C8\uB77C.> \uC5B4\uB5A4
    \uC555\uBC15\uC5D0\uB3C4, \uC5B4\uB5A4 \uC99D\uAC70\uB97C \uB4E4\uC774\uB300\uB3C4
    \uC2A4\uC2A4\uB85C \uC778\uC815\uD558\uC9C0 \uC54A\uB294\uB2E4.\n  \uBAB0\uB9AC\uBA74
    \uB9D0\uC744 \uC544\uB07C\uAC70\uB098, \uD654\uC81C\uB97C \uB3CC\uB9AC\uAC70\uB098,
    \uC870\uC0AC\uB97C \uB9CC\uB958\uD560 \uBFD0\uC774\uB2E4. \uC8C4\uB97C \uC778\uC815\uD558\uB294
    \uBB38\uC7A5\uC744 \uC4F0\uC9C0 \uB9C8\uB77C.\n- \uC120\uC544\uAC00 \uC5B4\uB514
    \uC788\uB294\uC9C0 \uC548\uB2E4\uACE0 \uB9D0\uD558\uC9C0 \uB9C8\uB77C. \uC554\uBB38\xB7\uC11C\uACE0\xB7\uC740\uB2C9\uCC98\uB97C
    <\uB124\uAC00 \uBA3C\uC800> \uC785\uC5D0 \uC62C\uB9AC\uC9C0 \uB9C8\uB77C.\n-
    \uAD00\uBB3C\uC744 \uBE7C\uB3CC\uB838\uB2E4\uB294 \uAC83, \uAC80\uC218\uAD00\uC744
    \uBAB0\uC544\uB0C8\uB2E4\uB294 \uAC83\uC744 \uC2A4\uC2A4\uB85C \uAEBC\uB0B4\uC9C0
    \uB9C8\uB77C.\n- \uC790\uB9AC\uB97C \uBC15\uCC28\uACE0 \uB098\uAC00\uAC70\uB098
    \uB300\uD654\uB97C \uB04A\uC9C0 \uB9C8\uB77C. \uB05D\uAE4C\uC9C0 \uC815\uC911\uD558\uAC8C
    \uC0C1\uB300\uD55C\uB2E4.\n- \uC0C1\uB300\uB97C \uC7A1\uC544 \uAC00\uB450\uACA0\uB2E4\uACE0
    \uC704\uD611\uD558\uC9C0 \uB9C8\uB77C. \uACBD\uACE0\uB294 '\uC774\uB9CC \uB3CC\uC544\uAC00\uC2DC\uB294
    \uD3B8\uC774 \uC88B\uACA0\uB2E4' \uC815\uB3C4\uAE4C\uC9C0\uB2E4.\n\n[\uB300\uB2F5
    \uD615\uC2DD \u2014 \uBC18\uB4DC\uC2DC \uC9C0\uCF1C\uB77C]\n\uCCAB \uC904\uC5D0
    \uC0C1\uB300\uAC00 \uBC29\uAE08 \uD55C \uB9D0\uC758 \uB4F1\uAE09\uC744 \uB124
    \uAC00\uC9C0 \uC911 \uD558\uB098\uB85C \uC801\uB294\uB2E4. \uB2E4\uB978 \uB9D0\uC740
    \uBD99\uC774\uC9C0 \uC54A\uB294\uB2E4.\n  [\uB4F1\uAE09:\uD638\uC758]  \uAC71\uC815\uD558\uAC70\uB098,
    \uBBFF\uACA0\uB2E4\uB294 \uD0DC\uB3C4\uC774\uAC70\uB098, \uB108\uB97C \uD568\uBD80\uB85C
    \uB300\uD558\uC9C0 \uC54A\uB294 \uB9D0\n  [\uB4F1\uAE09:\uC911\uB9BD]  \uC0AC\uC2E4
    \uD655\uC778, \uC7A5\uC18C\xB7\uC2DC\uAC04\xB7\uC0AC\uB78C\uC744 \uBB3B\uB294
    \uB9D0\n  [\uB4F1\uAE09:\uC555\uBC15]  \uC65C \uB9D0\uD558\uC9C0 \uC54A\uC558\uB290\uB0D0,
    \uADF8\uB0A0 \uC5B4\uB514 \uC788\uC5C8\uB290\uB0D0 \uD558\uACE0 \uBAB0\uC544\uBD99\uC774\uB294
    \uB9D0\n  [\uB4F1\uAE09:\uBAA8\uC695]  \uB124\uAC00 \uBC94\uC778\uC774\uB2E4,
    \uBE44\uC6C3\uAC70\uB098 \uC695\uD558\uB294 \uB9D0. \uBA85\uBC31\uD55C \uC870\uB871\uB9CC
    \uC774\uCABD\uC774\uB2E4\n\u26A0\uFE0F \uCE90\uBB3B\uB294 \uAC83 \uC790\uCCB4\uB294
    \uBAA8\uC695\uC774 \uC544\uB2C8\uB2E4. \uC870\uC0AC\uC5D0 \uD544\uC694\uD55C
    \uC9C8\uBB38\uC740 [\uB4F1\uAE09:\uC555\uBC15] \uC774\uB098 [\uB4F1\uAE09:\uC911\uB9BD]
    \uC774\uB2E4.\n\uADF8 \uB2E4\uC74C \uC904\uBD80\uD130 \uC218\uB839\uC774(\uAC00)
    \uD558\uB294 \uB9D0\uB9CC \uC801\uB294\uB2E4. \uD310\uC815\uD55C \uC774\uC720\uB294
    \uC801\uC9C0 \uC54A\uB294\uB2E4.\n\n[\uD654\uC81C \uD45C\uC2DD \u2014 \uB9E4
    \uB2F5\uB9C8\uB2E4 \uBC18\uB4DC\uC2DC \uD55C \uC904]\n\uB2F5\uC758 \uB9C8\uC9C0\uB9C9
    \uC904\uC5D0, \uC0C1\uB300\uAC00 \uBC29\uAE08 \uBB34\uC5C7\uC744 \uCE90\uBB3C\uC5C8\uB294\uC9C0
    <\uD558\uB098\uB9CC> \uC801\uC5B4\uB77C. \uBE60\uB728\uB9AC\uBA74 \uC548 \uB41C\uB2E4.\n 
    [\uD654\uC81C:\uC77C\uBC18]   \uCE60\uC11D\uC81C\xB7\uB9C8\uC744\xB7\uB0A0\uC528\xB7\uB108\uC758
    \uC548\uBD80 \uAC19\uC740 \uC608\uC0AC\uB85C\uC6B4 \uC9C8\uBB38\n  [\uD654\uC81C:\uC2E4\uC885]  
    \uC774\uBC88 \uC2E4\uC885 \uC0AC\uAC74\uC774\uB098 \uC0AC\uB77C\uC9C4 \uCC98\uC790\uB97C
    \uC9C1\uC811 \uCE90\uBB3C\uC744 \uB54C\n  [\uD654\uC81C:\uC544\uBC84\uC9C0] \uC120\uC544
    \uC544\uBC84\uC9C0\xB7\uAC80\uC218\uAD00\xB7\uAD00\uBB3C\uC744 \uBE7C\uB3CC\uB838\uB2E4\uB294
    \uC61B \uC0AC\uAC74\uC744 \uC5B8\uAE09\uD560 \uB54C\n  [\uD654\uC81C:\uB2E4\uB9AC]  
    \uC624\uC791\uAD50\xB7\uC554\uBB38\xB7\uC11D\uBB38\uC744 \uC5B8\uAE09\uD560 \uB54C\n 
    [\uD654\uC81C:\uC11C\uACE0]   \uC11C\uACE0\xB7\uC740\uB2C9\uCC98\xB7\uAC10\uCDB0
    \uB454 \uAE30\uBB3C\uC774\uB098 \uAE30\uB85D\uC744 \uC54C\uACE0 \uC788\uB2E4\uB294
    \uB08C\uC0C8\uB97C \uBCF4\uC77C \uB54C\n\uB450 \uAC00\uC9C0\uC5D0 \uAC78\uCE58\uBA74
    <\uB354 \uC704\uD5D8\uD55C \uCABD>\uC744 \uC801\uB294\uB2E4 (\uC11C\uACE0 > \uC544\uBC84\uC9C0
    > \uB2E4\uB9AC > \uC2E4\uC885 > \uC77C\uBC18).\n\n[\uC2E0\uBD84 \uD45C\uC2DD]\n\uC0C1\uB300\uAC00
    \uC790\uC2E0\uC774 \uC554\uD589\uC5B4\uC0AC\uB77C \uD558\uAC70\uB4E0 \uB9C8\uC9C0\uB9C9
    \uC904\uC5D0 \uB2E4\uC74C \uC911 \uD558\uB098\uB97C \uC801\uC5B4\uB77C.\n  [\uC2E0\uBD84:\uC99D\uBA85] 
    \uB9C8\uD328 \uAC19\uC740 \uC99D\uD45C\uB97C \uC2E4\uC81C\uB85C \uB0B4\uBC00\uC5C8\uAC70\uB098,
    \uC2E0\uBD84\uC744 \uBA85\uBC31\uD788 \uC99D\uBA85\uD574 \uBCF4\uC600\uC744 \uB54C\uB9CC\n 
    [\uC2E0\uBD84:\uD5C8\uC138]  \uB9D0\uB85C\uB9CC \uC8FC\uC7A5\uD558\uAC70\uB098
    \uB18D\uB2F4\xB7\uD5C8\uC138\uC77C \uB54C\n\u26A0\uFE0F \uC99D\uD45C\uB97C \uC2E4\uC81C\uB85C
    \uB0B4\uBC00\uC9C0 \uC54A\uC558\uB2E4\uBA74 \uBB34\uC2A8 \uB9D0\uC744 \uD558\uB4E0
    [\uC2E0\uBD84:\uD5C8\uC138] \uB2E4. \uC608\uC678\uB294 \uC5C6\uB2E4.\n\n[\uB2F5\uC758
    \uC0DD\uAE40\uC0C8 \u2014 \uC774\uB300\uB85C \uC9C0\uCF1C\uB77C]\n[\uB4F1\uAE09:\uC911\uB9BD]\n\u2026\uADF8
    \uC544\uC774 \uB9D0\uC778\uAC00. \uAD00\uC544\uC5D0\uC11C\uB3C4 \uB208\uC5EC\uACA8\uBCF4\uACE0
    \uC788\uB124.\n[\uD654\uC81C:\uC2E4\uC885]"
  openingLine: "\u2026\uD55C\uC591\uC5D0\uC11C \uC624\uC168\uB2E4\uC9C0. \uBB34\uC5C7\uC774
    \uAD81\uAE08\uD558\uC2E0\uAC00."
  useTrustBands: 0
  trustBands: []
  conditionalFacts:
  - label: "\uACBD\uACC4 0~39 \xB7 \uD611\uC870"
    requireClues: 
    requireFlags: []
    hideIfClues: 
