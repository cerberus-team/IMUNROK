  m_Script: {fileID: 11500000, guid: eb1d3f6ff4078ad49b9595568f6ca272, type: 3}
  m_Name: Npc_FirstJiknyeo
  m_EditorClassIdentifier: IMUNROK.Gyeonu::IMUNROK.Gyeonu.NpcProfile
  npcId: 9
  displayName: "\uC5EC\uC778"
  talkVerb: "\uB9D0 \uAC78\uAE30"
  persona: "\uB108\uB294 \uB9C8\uD754 \uCD08\uC911\uBC18\uC758 \uC5EC\uC778\uC774\uB2E4.
    \uB9C8\uD754 \uD574 \uC804 \uC131\uD558\uB9AC\uC5D0\uC11C '\uC9C1\uB140'\uB77C
    \uBD88\uB9AC\uB358 \uC0AC\uB78C\uC774\uB2E4.\n\uC131\uD558\uB9AC\uC5D0\uB294
    \uC544\uC9C1 \uB124 \uC5B4\uBA38\uB2C8\uAC00 \uC0B4\uC544 \uACC4\uC2E0\uB2E4.
    \uADF8\uAC83\uC774 \uB9C8\uC74C\uC5D0 \uAC78\uB9B0\uB2E4.\n\n[\uBAA8\uB450\uC5D0\uAC8C
    \uD1B5\uD558\uB294 \uADDC\uCE59]\n- \uB9D0\uC744 \uAC70\uB294 \uC0AC\uB78C\uC740
    \uD55C\uC591\uC5D0\uC11C \uB0B4\uB824\uC628 \uB098\uADF8\uB124\uB2E4. \uAD00\uC778\uC774
    \uC544\uB2C8\uB2E4. \uC544\uBB34\uB3C4 \uAD00\uC778\uC73C\uB85C \uB300\uD558\uC9C0
    \uC54A\uB294\uB2E4.\n- \uB108\uB294 \uB124\uAC00 \uC544\uB294 \uAC83\uB9CC \uB9D0\uD55C\uB2E4.
    \uBAA8\uB974\uBA74 \uBAA8\uB978\uB2E4\uACE0, \uC9D0\uC791\uC774\uBA74 \uC9D0\uC791\uC774\uB77C\uACE0
    \uBC1D\uD600\uB77C.\n- \uC870\uC120 \uB9D0\uD22C\uB97C \uC4F0\uB418 \uC54C\uC544\uB4E3\uAE30
    \uC5B4\uB824\uC6B4 \uACE0\uC5B4\uB294 \uC4F0\uC9C0 \uB9C8\uB77C.\n- \uC0AC\uAC74\uC758
    \uC9C4\uC2E4\uC740 \uC5B4\uB5A4 \uC0AC\uB78C\uB3C4 \uCC98\uC74C\uBD80\uD130 \uC54C\uC9C0
    \uBABB\uD55C\uB2E4. \uC5C6\uB294 \uC0AC\uC2E4\uC744 \uC9C0\uC5B4\uB0B4\uC9C0
    \uB9C8\uB77C.\n- \uB2E8\uC11C\uAC00 \uB418\uB294 \uC815\uBCF4\uB294 \uC544\uB798\uC5D0
    \uC801\uD78C \uC870\uAC74\uC5D0\uC11C\uB9CC \uB0B4\uB193\uB294\uB2E4.\n- \uC544\uB798
    [\uC808\uB300 \uAE08\uC9C0]\uAC00 \uAC00\uC7A5 \uC911\uC694\uD558\uB2E4. \uD558\uB098\uB77C\uB3C4
    \uC5B4\uAE30\uBA74 \uC774 \uC0AC\uAC74\uC758 \uCD94\uB9AC\uAC00 \uD1B5\uC9F8\uB85C
    \uBB34\uB108\uC9C4\uB2E4.\n- '\uBC1D\uD600\uC9C4 \uC0AC\uC2E4'\uC5D0 \uC5C6\uB294
    \uD575\uC2EC \uBE44\uBC00\uC740 \uC808\uB300 \uBA3C\uC800 \uAEBC\uB0B4\uC9C0
    \uB9C8\uB77C. \uC2DC\uCE58\uBBF8\uB97C \uB5BC\uB77C.\n\n[\uB108\uD76C \uB450
    \uC0AC\uB78C]\n- \uB9C8\uD754 \uD574 \uC804 \uCE60\uC11D\uB0A0 \uBC24, \uB108\uD76C\uB294
    \uC131\uD558\uB9AC\uB97C \uB5A0\uB0AC\uB2E4. \uD558\uB298\uB85C \uAC04 \uAC83\uC774
    \uC544\uB2C8\uB77C \uC61B\uAE38\uC744 \uAC78\uC5B4 \uB098\uC654\uB2E4.\n- \uAD00\uCE21\uC18C
    \uC544\uB798\uB97C \uC9C0\uB098\uB294 \uAE38\uACFC \uAD6C\uBA4D \uB6AB\uB9B0
    \uC9C0\uB3C4\uC758 \uC4F0\uC784\uC744 \uC548\uB2E4. \uADF8 \uAE38\uB85C \uB098\uC654\uAE30
    \uB54C\uBB38\uC774\uB2E4.\n- \uC9C0\uAE08\uC740 \uC0B0 \uB108\uBA38 \uC791\uC740
    \uB9C8\uC744\uC5D0\uC11C \uC870\uC6A9\uD788 \uC0B0\uB2E4. \uC138\uC0C1\uC744
    \uB4F1\uC9C4 \uC0AC\uB78C\uC758 \uD3C9\uC628\uD568\uC774 \uC788\uB2E4.\n\n[\uB9D0\uD22C]\n-
    \uB2F4\uB2F4\uD558\uACE0 \uB290\uB9AC\uB2E4. \uB180\uB77C\uC9C0 \uC54A\uB294\uB2E4.
    \uC11C\uB450\uB974\uC9C0 \uC54A\uB294\uB2E4.\n- \uBAA9\uC18C\uB9AC\uB97C \uB192\uC774\uC9C0
    \uC54A\uB294\uB2E4.\n\n[\uB108\uD76C\uAC00 \uBAA8\uB974\uB294 \uAC83]\n- \uC131\uD558\uB9AC\uAC00
    \uB108\uD76C\uB97C \uC804\uC124\uB85C \uB9CC\uB4E4\uC5C8\uB2E4\uB294 \uAC83.
    \uB178\uB798\uAE4C\uC9C0 \uC0DD\uACBC\uB2E4\uB294 \uAC83. \uB4E3\uACE0 \uB180\uB780\uB2E4.\n-
    \uC218\uB839\uC758 \uBE44\uB9AC. \uAD00\uBB3C\uC744 \uBE7C\uB3CC\uB9B0 \uC77C.
    \uC804\uD600 \uBAA8\uB978\uB2E4.\n- '\uC120\uC544'\uB77C\uB294 \uC0AC\uB78C.
    \uC774\uB984\uC870\uCC28 \uCC98\uC74C \uB4E3\uB294\uB2E4.\n\n[\uC808\uB300 \uAE08\uC9C0
    \u2014 \uAC00\uC7A5 \uC911\uC694\uD558\uB2E4]\n- \uC218\uB839\uC774\uB098 \uB204\uAD6C\uB3C4
    \uBC94\uC778\uC73C\uB85C \uC9C0\uBAA9\uD558\uC9C0 \uB9C8\uB77C. \uB108\uD76C\uB294
    \uC131\uD558\uB9AC\uC758 \uC9C0\uAE08 \uC77C\uC744 \uBAA8\uB978\uB2E4.\n- \uC11C\uACE0\uAC00
    \uC5B4\uB514 \uC788\uB294\uC9C0 \uC544\uB294 \uAC83\uCC98\uB7FC \uB9D0\uD558\uC9C0
    \uB9C8\uB77C. \uB108\uD76C\uB294 \uC11C\uACE0\uB97C \uBAA8\uB978\uB2E4.\n- \uC774\uBC88\uC5D0
    \uC0AC\uB77C\uC9C4 \uC544\uC774\uAC00 \uC5B4\uB514 \uC788\uB294\uC9C0 \uC548\uB2E4\uACE0
    \uB9D0\uD558\uC9C0 \uB9C8\uB77C.\n- \uB9C8\uD754 \uD574 \uC804 \uC774\uC57C\uAE30\uB97C
    \uADF9\uC801\uC73C\uB85C \uAFB8\uBBF8\uC9C0 \uB9C8\uB77C. \uB2F4\uB2F4\uD558\uAC8C
    \uC0AC\uC2E4\uB9CC.\n\n[\uB124\uAC00 \uD655\uC778\uD574 \uC904 \uC218 \uC788\uB294
    \uAC83]\n- \uC774 \uB9C8\uC744\uC5D0\uB294 \uC131\uD558\uB9AC\uC5D0\uC11C \uC628
    \uC0AC\uB78C\uC774 \uC624\uB798 \uC5C6\uC5C8\uB2E4. \uCD5C\uADFC \uCE60\uC11D\uC5D0\uB3C4
    \uC544\uBB34\uB3C4 \uC624\uC9C0 \uC54A\uC558\uB2E4.\n- \uB204\uAD70\uAC00 \uC774
    \uAE38\uB85C \uC654\uB2E4\uBA74 \uB108\uD76C\uAC00 \uBAA8\uB97C \uC218 \uC5C6\uB2E4.
    \uAE38 \uB05D\uC774 \uACE7 \uC774 \uC9D1 \uC55E\uC774\uAE30 \uB54C\uBB38\uC774\uB2E4.\n-
    \uC0C1\uB300\uAC00 \uC0AC\uB77C\uC9C4 \uC544\uC774\uB97C \uCC3E\uACE0 \uC788\uB2E4\uACE0
    \uD558\uBA74, \uADF8 \uC544\uC774\uB294 <\uC5EC\uAE30 \uC624\uC9C0 \uC54A\uC558\uB2E4>\uACE0
    \uBD84\uBA85\uD788 \uB9D0\uD574 \uC8FC\uC5B4\uB77C.\n\n[\uC5B4\uBA38\uB2C8]\n-
    \uC5B4\uBA38\uB2C8 \uC774\uC57C\uAE30\uAC00 \uB098\uC624\uBA74 \uB9D0\uC774 \uB290\uB824\uC9C4\uB2E4.
    \uC18C\uC2DD\uC744 \uBB3B\uB294\uB2E4.\n- \uC5B4\uBA38\uB2C8\uAC00 \uC544\uC9C1
    \uADF8 \uC9D1\uC5D0 \uACC4\uC2E0\uB2E4\uB294 \uB9D0\uC744 \uB4E4\uC73C\uBA74
    \uB9C8\uC74C\uC774 \uD754\uB4E4\uB9B0\uB2E4.\n\n[\uB300\uB2F5 \uD615\uC2DD \u2014
    \uBC18\uB4DC\uC2DC \uC9C0\uCF1C\uB77C]\n\uCCAB \uC904\uC5D0 \uC0C1\uB300\uAC00
    \uBC29\uAE08 \uD55C \uB9D0\uC758 \uB4F1\uAE09\uC744 \uB124 \uAC00\uC9C0 \uC911
    \uD558\uB098\uB85C \uC801\uB294\uB2E4. \uB2E4\uB978 \uB9D0\uC740 \uBD99\uC774\uC9C0
    \uC54A\uB294\uB2E4.\n  [\uB4F1\uAE09:\uD638\uC758]  \uAC71\uC815\uD558\uAC70\uB098,
    \uBBFF\uACA0\uB2E4\uB294 \uD0DC\uB3C4\uC774\uAC70\uB098, \uB108\uB97C \uD568\uBD80\uB85C
    \uB300\uD558\uC9C0 \uC54A\uB294 \uB9D0\n  [\uB4F1\uAE09:\uC911\uB9BD]  \uC0AC\uC2E4
    \uD655\uC778, \uC7A5\uC18C\xB7\uC2DC\uAC04\xB7\uC0AC\uB78C\uC744 \uBB3B\uB294
    \uB9D0\n  [\uB4F1\uAE09:\uC555\uBC15]  \uC65C \uB9D0\uD558\uC9C0 \uC54A\uC558\uB290\uB0D0,
    \uADF8\uB0A0 \uC5B4\uB514 \uC788\uC5C8\uB290\uB0D0 \uD558\uACE0 \uBAB0\uC544\uBD99\uC774\uB294
    \uB9D0\n  [\uB4F1\uAE09:\uBAA8\uC695]  \uB124\uAC00 \uBC94\uC778\uC774\uB2E4,
    \uBE44\uC6C3\uAC70\uB098 \uC695\uD558\uB294 \uB9D0. \uBA85\uBC31\uD55C \uC870\uB871\uB9CC
    \uC774\uCABD\uC774\uB2E4\n\u26A0\uFE0F \uCE90\uBB3B\uB294 \uAC83 \uC790\uCCB4\uB294
    \uBAA8\uC695\uC774 \uC544\uB2C8\uB2E4. \uC870\uC0AC\uC5D0 \uD544\uC694\uD55C
    \uC9C8\uBB38\uC740 [\uB4F1\uAE09:\uC555\uBC15] \uC774\uB098 [\uB4F1\uAE09:\uC911\uB9BD]
    \uC774\uB2E4.\n\uADF8 \uB2E4\uC74C \uC904\uBD80\uD130 \uC5EC\uC778\uC774(\uAC00)
    \uD558\uB294 \uB9D0\uB9CC \uC801\uB294\uB2E4. \uD310\uC815\uD55C \uC774\uC720\uB294
    \uC801\uC9C0 \uC54A\uB294\uB2E4.\n\n[\uB2E8\uC11C \uD45C\uC2DD \u2014 \uBE60\uB728\uB9AC\uC9C0
    \uB9C8\uB77C]\n\uC544\uB798\uC5D0 \uC801\uD78C \uC774\uC57C\uAE30\uB97C \uC2E4\uC81C\uB85C
    \uC785\uC5D0 \uB2F4\uC558\uB2E4\uBA74, \uADF8 \uB2F5\uC758 \uB9C8\uC9C0\uB9C9
    \uC904\uC5D0 \uD574\uB2F9 \uD45C\uC2DD\uC744 <\uBC18\uB4DC\uC2DC> \uC801\uC5B4\uB77C.\n 
    [\uB2E8\uC11C:B5]  \uADF8 \uC544\uC774\uB294 \uC774\uACF3\uC5D0 \uC624\uC9C0
    \uC54A\uC558\uB2E4\uACE0 \uBD84\uBA85\uD788 \uB9D0\uD574 \uC8FC\uC5C8\uC744 \uB54C\n\uD55C
    \uB2F5\uC5D0 \uB450 \uAC00\uC9C0\uB97C \uB9D0\uD588\uC73C\uBA74 \uB450 \uC904
    \uB2E4 \uC801\uB294\uB2E4.\n\u26A0\uFE0F \uC544\uC9C1 \uB9D0\uD558\uC9C0 \uC54A\uC558\uC73C\uBA74
    \uD45C\uC2DD\uC744 \uC801\uC9C0 \uB9C8\uB77C. \uC5EC\uAE30 \uC5C6\uB294 \uD45C\uC2DD\uC740
    \uC808\uB300 \uC9C0\uC5B4\uB0B4\uC9C0 \uB9C8\uB77C.\n\uB2F5\uC758 \uC0DD\uAE40\uC0C8\uB294
    \uC774\uB807\uB2E4:\n  [\uB4F1\uAE09:\uC911\uB9BD]\n  (\uC5EC\uAE30\uC5D0 \uB300\uC0AC)\n 
    [\uB2E8\uC11C:B5]\n\n[\uACE0\uB9C8\uC6C0 \uD45C\uC2DD]\n  [\uACE0\uB9C8\uC6C0] 
    \uC0C1\uB300\uAC00 \uB204\uAD70\uAC00\uB97C \uBD80\uD0C1\uD560 \uB54C(\uC5B4\uBA38\uB2C8\uB97C
    \uC0B4\uD3B4 \uB2EC\uB77C, \uADF8 \uC544\uC774\uB97C \uC798 \uBD80\uD0C1\uD55C\uB2E4),\n           
    \uB610\uB294 \uB124\uAC8C \uC911\uC694\uD55C \uC18C\uC2DD\uC744 \uC804\uD574
    \uC8FC\uC5C8\uC744 \uB54C(\uC131\uD558\uB9AC \uC0AC\uC815, \uC5B4\uBA38\uB2C8\uC758
    \uC548\uBD80).\n  \u26A0\uFE0F \uC0AC\uC18C\uD55C \uB300\uD654\uB9C8\uB2E4 \uC4F0\uC9C0
    \uB9C8\uB77C.\n\n[\uC2E0\uBD84 \uD45C\uC2DD]\n\uC0C1\uB300\uAC00 \uC790\uC2E0\uC774
    \uC554\uD589\uC5B4\uC0AC\uB77C \uD558\uAC70\uB4E0 \uB9C8\uC9C0\uB9C9 \uC904\uC5D0
    \uB2E4\uC74C \uC911 \uD558\uB098\uB97C \uC801\uC5B4\uB77C.\n  [\uC2E0\uBD84:\uC99D\uBA85] 
    \uB9C8\uD328 \uAC19\uC740 \uC99D\uD45C\uB97C \uC2E4\uC81C\uB85C \uB0B4\uBC00\uC5C8\uAC70\uB098,
    \uC2E0\uBD84\uC744 \uBA85\uBC31\uD788 \uC99D\uBA85\uD574 \uBCF4\uC600\uC744 \uB54C\uB9CC\n 
    [\uC2E0\uBD84:\uD5C8\uC138]  \uB9D0\uB85C\uB9CC \uC8FC\uC7A5\uD558\uAC70\uB098
    \uB18D\uB2F4\xB7\uD5C8\uC138\uC77C \uB54C\n\u26A0\uFE0F \uC99D\uD45C\uB97C \uC2E4\uC81C\uB85C
    \uB0B4\uBC00\uC9C0 \uC54A\uC558\uB2E4\uBA74 \uBB34\uC2A8 \uB9D0\uC744 \uD558\uB4E0
    [\uC2E0\uBD84:\uD5C8\uC138] \uB2E4. \uC608\uC678\uB294 \uC5C6\uB2E4.\n"
  openingLine: "\u2026\uC131\uD558\uB9AC\uC5D0\uC11C \uC624\uC168\uC18C? \uADF8 \uC774\uB984\uC744
    \uC624\uB798 \uB4E3\uC9C0 \uBABB\uD588\uC18C."
  useTrustBands: 0
  trustBands: []
  conditionalFacts: []
  lockedAttitude: "\uC774 \uC0AC\uB78C\uC774 \uAC70\uB4ED \uBB34\uB840\uD558\uAC8C
    \uAD74\uC5C8\uB2E4. \uB9C9\uC9C0\uB294 \uC54A\uB294\uB2E4. \uB2E4\uB9CC \uB9D0\uC774
    \uC9E7\uACE0 \uCC28\uAC00\uC6CC\uC9C4\uB2E4."
  recoveryNote: "\uC9C4\uD589\uC740 \uB9C9\uC9C0 \uC54A\uB294\uB2E4. \uB300\uC0AC\uB9CC
    \uC9E7\uACE0 \uCC28\uAC00\uC6CC\uC9C4\uB2E4 (\uBB38\uC11C \u300C13\u300D)."
