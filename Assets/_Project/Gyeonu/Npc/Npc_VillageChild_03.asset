  lockedAttitude: "\uC774 \uC5B4\uB978\uC774 \uBB34\uC12D\uB2E4. \uB4A4\uB85C \uBB3C\uB7EC\uB098
    \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uB294\uB2E4."
  recoveryNote: "\uB2E4\uC74C \uB0A0 \uB610\uB294 \uB2E4\uC74C \uC8FC\uC694 \uC2DC\uAC04\uB300
