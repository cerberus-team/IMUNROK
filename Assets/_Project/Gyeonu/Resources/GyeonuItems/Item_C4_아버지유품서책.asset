  m_EditorClassIdentifier: IMUNROK.Gyeonu::IMUNROK.Gyeonu.InventoryItem
  itemId: C4
  displayName: "\uC544\uBC84\uC9C0\uC758 \uC720\uD488 \uC11C\uCC45"
  pickupVerb: "\uC0B4\uD53C\uAE30"
  description: "\uC120\uC544\uC758 \uC544\uBC84\uC9C0\uAC00 \uB0A8\uAE34 \uC11C\uCC45.
    \uAC89\uC7A5\uC740 \uC190\uB54C\uB85C \uBC18\uB4E4\uAC70\uB9AC\uACE0, \uC544\uB798\uCABD
    \uBAA8\uC11C\uB9AC\uAC00 \uB2F3\uC544 \uC788\uB2E4.\n\n\uC18D\uC7A5\uC5D0\uB294
    \uBC24\uD558\uB298\uC758 \uBCC4\uC790\uB9AC\uB97C \uC9DA\uC740 \uADF8\uB9BC\uACFC,
    \uB0A0\uC9DC\uB85C \uBCF4\uC774\uB294 \uC22B\uC790\uAC00 \uC787\uB2EC\uC544 \uC801\uD600
    \uC788\uB2E4. \uAE00\uC528\uB294 \uAE09\uD558\uAC8C \uC4F4 \uB4EF \uAE30\uC6B8\uC5C8\uACE0,
    \uBA87 \uC904\uC740 \uBA39\uC774 \uBC88\uC838 \uC77D\uAE30 \uC5B4\uB835\uB2E4.\n\n\uB9C8\uC9C0\uB9C9
    \uC7A5\uC5D0\uB294 \uB2E4\uB978 \uD544\uCCB4\uB85C \uC9E7\uAC8C \uB367\uBD99\uC5B4
    \uC788\uB2E4.\n  \u300C\uCE60\uC11D \uC804\uB0A0, \uBB3C\uC774 \uAC00\uC7A5 \uB0AE\uC744
    \uB54C. \uB2E4\uB9AC \uC544\uB798\uB85C.\u300D\n\n(\uC784\uC2DC \uC124\uBA85
    \u2014 \uC2E4\uC81C \uB2E8\uC11C \uBB38\uC548\uC774 \uC815\uD574\uC9C0\uBA74
    \uC774 \uAE00\uB9CC \uBC14\uAFB8\uBA74 \uB41C\uB2E4. \uC5EC\uAE30 \uC801\uD78C
    \uAE00\uC774 \uAE38\uC5B4\uC838\uB3C4 \uD720\uB85C \uAD74\uB824 \uC77D\uC744
    \uC218 \uC788\uB294\uC9C0 \uD655\uC778\uD558\uB824\uACE0 \uC77C\uBD80\uB7EC \uAE38\uAC8C
    \uB450\uC5C8\uB2E4.)"
