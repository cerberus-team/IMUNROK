  _maxTouchDistance: 2.5
  _title: "\uB4F1\uACBD"
  _emptyBody: "\uB4F1\uC794\uC744 \uC5B9\uB294 \uC790\uB9AC\uB2E4. \uAC78\uC774\uAC00
    \uBE44\uC5B4 \uC788\uB2E4."
  _readyBody: "\uC5EC\uAE30 \uB4F1\uBD88\uC744 \uC5B9\uC73C\uBA74 \uB450 \uC190\uC774
    \uBE48\uB2E4."
  _litBody: "\uB4F1\uBD88\uC774 \uAC78\uB824 \uC788\uB2E4. \uC774 \uC790\uB9AC\uB97C
    \uBE44\uCD94\uACE0 \uC788\uB2E4."
  _readyHint: "(\uB20C\uB7EC \uC5B9\uAE30)"
  _litHint: "(\uB20C\uB7EC \uB3C4\uB85C \uB4E4\uAE30)"
  _nudgeWithin: 3
  _nudgeAfter: 0.5
  _nudgeEmptyHanded: "\uC5B4\uB461\uB2E4. \uB4F1\uBD88\uC744 \uB4E4\uACE0 \uC640
    \uB4F1\uACBD\uC5D0 \uC5B9\uC5B4\uC57C \uB4A4\uC9C8 \uB9CC\uD558\uACA0\uB2E4."
  _nudgeHolding: "\uB4F1\uBD88\uC744 \uB4E0 \uCC44\uB85C\uB294 \uD55C \uC190\uBFD0\uC774\uB2E4.
    *\uB4F1\uACBD*\uC5D0 \uC5B9\uC73C\uBA74 \uB450 \uC190\uC774 \uBE48\uB2E4."
