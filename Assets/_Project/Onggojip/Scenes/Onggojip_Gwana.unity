  m_Script: {fileID: 11500000, guid: a0a7eead72e4db44fac07b66fc730dbb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: IMUNROK.Common::IMUNROK.Common.CrossCheck
  _case: 0
  _pairs:
  - "\uC774\uB984": "\uD638\uC801 \u2014 \uD30C\uAE30"
    "\uC774\uCABD": G01
    "\uC800\uCABD": J12
    "\uB9DE\uB300\uBA74": "\uC9D1\uC5D0\uC11C \uBCF8 \uD638\uC801\uACFC \uAC19\uC740
      \uCC45\uC778\uB370 <b>\uC6D0\uBCF8\uC5D0\uB294 \uD55C \uC904\uC774 \uB354 \uC788\uB2E4</b>.\n\u300C\uB178
      \uBCF5\uB3D9 \u2014 \uC67C\uD314 \uC548\uCABD \uB370\uC778 \uC790\uAD6D *\uB450
      \uCE58 \uB0A8\uC9D3*\u300D\n\uC2A4\uBB34 \uD574 \uC804 \uAD00\uB9AC\uAC00 \uC801\uC5B4
      \uB454 \uAC83\uC774\uB77C \uC544\uBB34\uB3C4 \uC190\uB308 \uC218 \uC5C6\uC5C8\uB2E4."
    "\uC0C8\uB2E8\uC11Ckey": 
    "\uC0C8\uB2E8\uC11C": 
    "\uADF8\uB54C":
      m_PersistentCalls:
        m_Calls: []
  - "\uC774\uB984": "\uD638\uAD6C\uB2E8\uC790 \u2014 \uAC19\uC740 \uC190"
    "\uC774\uCABD": G02
    "\uC800\uCABD": J13
    "\uB9DE\uB300\uBA74": "\uAD00\uC544\uAC00 \uBC1B\uC544 \uB454 \uAC83\uACFC \uC9D1\uC5D0\uC11C
      \uB098\uC628 \uAC83\uC774 <b>\uAC19\uC740 \uC190</b>\uC774\uB2E4.\n\uAD00\uB9AC\uB294
      \uB9E8 \uB05D \u300C\uB3C4\uBD80(\u5230\u4ED8)\u300D \uD55C \uC904\uB9CC \uC37C\uB2E4
      \u2014 \uB098\uBA38\uC9C0\uB294 *\uC774 \uC9D1 \uC0AC\uB78C\uC774 \uC37C\uB2E4*."
    "\uC0C8\uB2E8\uC11Ckey": 
    "\uC0C8\uB2E8\uC11C": 
    "\uADF8\uB54C":
      m_PersistentCalls:
        m_Calls: []
  - "\uC774\uB984": "\uBCC4\uAE09\uBB38\uAE30 \u2014 \uAD00\uC758 \uCC45"
    "\uC774\uCABD": G03
    "\uC800\uCABD": J11
    "\uB9DE\uB300\uBA74": "\uBCF4\uB8CC \uBC11\uC758 \uBCC4\uAE09\uBB38\uAE30\uAC00
      \uAD00\uC758 \uCC45\uC5D0\uB3C4 \uADF8\uB300\uB85C \uC788\uB2E4.\n\uC218\uCDE8\uC778\uC740
      \u300C\uC624\uB798 \uBD80\uB9B0 \uC885 \uBCF5\uB3D9\u300D, \uADF8\uB9AC\uACE0
      \u300C\uBA74\uCC9C \uC5C6\uC74C\u300D \u2014\n\uC7AC\uC0B0\uC740 \uBC1B\uC558\uC73C\uB418
      *\uC885\uC5D0\uC11C \uD480\uB824\uB09C \uC801\uC740 \uC5C6\uB2E4*."
    "\uC0C8\uB2E8\uC11Ckey": 
    "\uC0C8\uB2E8\uC11C": 
    "\uADF8\uB54C":
      m_PersistentCalls:
        m_Calls: []
  - "\uC774\uB984": "\uC18C\uC791\uB8CC \u2014 \uD55C \uB2EC"
    "\uC774\uCABD": G04
    "\uC800\uCABD": J01
    "\uB9DE\uB300\uBA74": "\uD55C \uB2EC \uC804\uBD80\uD130 \uC18C\uC791\uB8CC\uAC00
      \uC11C\uB978 \uB9D0\uC5D0\uC11C *\uC2A4\uBB34 \uB9D0*\uB85C \uB0B4\uB838\uB2E4.\n\uB9C8\uC744\uC774
      \u7532\uC744 \uC8FC\uC778\uC73C\uB85C \uC544\uB294 \uAC12\uC774 \uC5EC\uAE30
      \uC22B\uC790\uB85C \uB0A8\uC544 \uC788\uB2E4."
    "\uC0C8\uB2E8\uC11Ckey": 
    "\uC0C8\uB2E8\uC11C": 
    "\uADF8\uB54C":
      m_PersistentCalls:
        m_Calls: []
