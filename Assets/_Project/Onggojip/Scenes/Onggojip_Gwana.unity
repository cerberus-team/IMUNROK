--- !u!114 &1175123082
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1175123080}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6b8e8c95a8470bf4eb8d40d4c9e925c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: IMUNROK.Common::IMUNROK.Common.InspectableNote
  _page: {fileID: 2800000, guid: 5f5cf99953177df45984d2af376a3a2b, type: 3}
  _canOpen: 1
  _maxTouchDistance: 3
  _fineText: "\uC885 \uBCF5\uB3D9\uC758 \uC904 \uACC1, \uC791\uC740 \uAE00\uC528\uB85C
    \u2014 \u300C\u5DE6\u81C2\u5167 \u706B\u50B7\u75D5 \u4E8C\u5BF8\u8A31\u300D.
    \uC0AC\uB78C\uC744 \uAC00\uB824 \uC801\uB294 \uD45C\uC2DD\uC774\uB2E4."
  _clueNeedsMagnifier: 0
  _dimBehind: 1
  _clueNoteAfterMagnify: "\uB3CB\uBCF4\uAE30\uB85C \uBCF4\uB2C8 \u2014 \uD45C\uC2DD\uC740
    \uAD00\uC758 \uC11C\uB9AC\uAC00 \uD638\uAD6C\uB97C \uC870\uC0AC\uD558\uBA70 \uC801\uC740
    \uAC83\uC774\uB2E4. \uC0AC\uB78C\uC758 \uB9D0\uC740 \uBC14\uB00C\uC5B4\uB3C4
    \uC774 \uB450 \uCE58\uB294 \uADF8 \uBAB8\uC5D0 \uB0A8\uC544 \uC788\uC744 \uAC83\uC774\uB2E4.
    \uC720\uCC99\uC73C\uB85C \uC7AC\uC5B4 \uBCFC \uC218 \uC788\uB2E4."
  _model: {fileID: 0}
  _modelEuler: {x: 0, y: 0, z: 0}
  _pageKo: {fileID: 2800000, guid: 6010545ed48523e4989b8a5ba3d7bda4, type: 3}
  _revealsPressed: {fileID: 0}
  _backPage: {fileID: 2800000, guid: 83ff8cbb68aecf54fa265f71661f8852, type: 3}
  _litPage: {fileID: 0}
  _litText: 
  _clueNeedsLantern: 0
  _litGlyphs: 
  _litClueKey: 
  _litClueOwnText: 
  _litClueText: 
  _title: "\uD638\uC801\uB300\uC7A5"
  _body: "\uC0BC \uB144 \uC804 \uC2DD\uB144\uC5D0 \uAD00\uC758 \uC11C\uB9AC\uAC00
    \uACE0\uC744 \uD638\uAD6C\uB97C \uC815\uC11C\uD574 \uBB36\uC740 \uCC45."
  _requiresMagnifier: 0
  _recordClue: 1
  _clueCase: 0
  _clueKey: G01
  _clueText: "[G01] \uAD00\uC544\uC5D0 \uC788\uB294 \uD638\uC801\uB300\uC7A5 \uC6D0\uBCF8(\uC0BC
    \uB144 \uC804). \uC885 \uBCF5\uB3D9\uC758 \uC904 \uACC1\uC5D0 \uD55C \uC904\uC774
    \uB354 \uC788\uB2E4 \u2014 \u300C<b>\uC67C\uD314 \uC548\uCABD \uB370\uC778 \uC790\uAD6D,
    \uB450 \uCE58 \uB0A8\uC9D3</b>\u300D."
  _clueImage: {fileID: 0}
