--- !u!114 &377285328
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 377285326}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6b8e8c95a8470bf4eb8d40d4c9e925c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: IMUNROK.Common::IMUNROK.Common.InspectableNote
  _page: {fileID: 2800000, guid: dc97cb99e29d4b8419e3268c61a08ba6, type: 3}
  _canOpen: 1
  _maxTouchDistance: 3
  _fineText: "\uB2E4\uC12F\uC9F8 \uC904\uB9CC \uBA39\uBE5B\uC774 \uC605\uB2E4. \uD68D
    \uB05D\uC774 \uBB49\uAC1C\uC9C0\uACE0 \uC885\uC774 \uACB0\uC774 \uC77C\uC5B4\uB098
    \uC788\uB2E4 \u2014 *\uAE01\uC5B4\uB0B4\uACE0 \uADF8 \uC704\uC5D0 \uB367\uC4F4*
    \uC790\uB9AC\uB2E4."
  _clueNeedsMagnifier: 0
  _litPage: {fileID: 2800000, guid: 607c8321a128a4e44b20e656b676fcfb, type: 3}
  _litText: "\uAE01\uC5B4\uB0B8 \uC790\uB9AC \uBC11\uC5D0\uC11C \uC9C0\uC6B4 \uAE00\uC774
    \uBC30\uC5B4 \uB098\uC628\uB2E4 \u2014 *\u300C\uBCF5\uB3D9 \uBA74\uCC9C(\u514D\u8CE4),
    \uAE30\uBB18\uB144 \uC2DC\uC6D4\u300D*. \uAD00\uC774 \uC774\uBBF8 \uB193\uC544\uC900
    \uAC83\uC744 \uB204\uAD70\uAC00 \uB3C4\uB85C \uC885\uC73C\uB85C \uB9CC\uB4E4\uC5B4
    \uB193\uC558\uB2E4."
  _clueNeedsLantern: 0
  _litGlyphs: "\u514D\u8CE4"
  _litClueKey: G05
  _litClueOwnText: "\uC785\uC548\uB300\uC7A5 \uB2E4\uC12F\uC9F8 \uC904\uC740 \uAE01\uC5B4\uB0B4\uACE0
    \uB367\uC4F4 \uAC83\uC774\uB2E4. \uC9C0\uC6B4 \uBC11\uAE00\uC740 \u300C\u514D\u8CE4
    \u5DF1\u536F\u5341\u6708\u300D \u2014 \uBCF5\uB3D9\uC740 \uC774\uBBF8 \uB193\uC5EC\uB09C
    \uBAB8\uC774\uC5C8\uB2E4."
  _litClueText: "\uC785\uC548\uB300\uC7A5 \uB2E4\uC12F\uC9F8 \uC904\uC740 \uAE01\uC5B4\uB0B4\uACE0
    \uB367\uC4F4 \uAC83\uC774\uB2E4. \uC9C0\uC6B4 \uBC11\uAE00\uC740 \u300C\uBCF5\uB3D9
    \uBA74\uCC9C, \uAE30\uBB18\uB144 \uC2DC\uC6D4\u300D \u2014 \uBCF5\uB3D9\uC740
    \uC774\uBBF8 \uBA74\uCC9C\uB41C \uBAB8\uC774\uB2E4. \uC774 \uCC45\uC774 \uACE0\uCCD0\uC9C4
    \uB355\uC5D0 \uC544\uC9C1 \uC885\uC73C\uB85C \uB0A8\uC544 \uC788\uB2E4."
  _title: "\uC785\uC548\uB300\uC7A5"
  _body: "\uAD00\uC774 \uBB38\uC11C\uB97C \uC778\uC815\uD574 \uC900 \uAE30\uB85D.
    \uBCC4\uAE09\uBB38\uAE30\uC758 \uC0AC\uBCF8\uC774 \uC5EC\uAE30 \uC788\uB2E4."
  _requiresMagnifier: 0
  _recordClue: 1
  _clueCase: 0
  _clueKey: G03
  _clueText: "\uC785\uC548 \uB300\uC7A5 \u2014 \uBCC4\uAE09\uBB38\uAE30 \uC0AC\uBCF8,
    \uC218\uCDE8\uC778 \"\uC885 \uBCF5\uB3D9\""
  _clueImage: {fileID: 0}
