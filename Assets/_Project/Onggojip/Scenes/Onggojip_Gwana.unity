  m_Script: {fileID: 11500000, guid: 6b8e8c95a8470bf4eb8d40d4c9e925c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: IMUNROK.Common::IMUNROK.Common.InspectableNote
  _page: {fileID: 2800000, guid: e9f60dd697cac9e4e93f66889dd9f93b, type: 3}
  _canOpen: 1
  _maxTouchDistance: 3
  _fineText: "\uB05D\uC758 \u300C\u5230\u4ED8\u300D \uD55C \uC904\uB9CC \uAD00\uC758
    \uD574\uC11C\uCCB4\uB2E4. \uC704\uC758 \uC5EC\uB7EC \uC904\uC740 \uAE30\uC6B8\uACE0
    \uD68D \uB05D\uC774 \uB4E4\uB72C \uC190\uC73C\uB85C \uC4F0\uC600\uB2E4."
  _clueNeedsMagnifier: 0
  _dimBehind: 1
  _clueNoteAfterMagnify: "\uB3CB\uBCF4\uAE30\uB85C \uBCF4\uB2C8 \u2014 \uAD00\uB9AC\uAC00
    \uC4F4 \uAC83\uC740 \uB05D\uC758 \u300C\uB3C4\uBD80(\u5230\u4ED8)\u300D \uD55C
    \uC904\uBFD0\uC774\uB2E4. \uB098\uBA38\uC9C0\uB294 \uC774 \uC9D1\uC5D0\uC11C
    \uC4F4 \uC190\uC778\uB370, \uD68D\uC744 \uB9FA\uACE0 \uB5BC\uB294 \uBC84\uB987\uC774
    \uC0AC\uB791\uBC29 \uC7A5\uBD80 \uB05D \uB450 \uC904\uC758 \uC0C8 \uC190\uACFC
    \uAC19\uB2E4."
  _model: {fileID: 0}
  _modelEuler: {x: 0, y: 0, z: 0}
  _pageKo: {fileID: 2800000, guid: 1b4cce87bc77aa04d942f65bfbb012c4, type: 3}
  _revealsPressed: {fileID: 0}
  _backPage: {fileID: 2800000, guid: 7f779fd13f2372544a13c4f789601dae, type: 3}
  _litPage: {fileID: 0}
  _litText: 
  _clueNeedsLantern: 0
  _litGlyphs: 
  _litClueKey: 
  _litClueOwnText: 
  _litClueText: 
  _title: "\uD638\uAD6C\uB2E8\uC790"
  _body: "\uC62C\uD574 \uC2DD\uB144\uC5D0 \uC774 \uC9D1\uC5D0\uC11C \uC62C\uB9B0
    \uD638\uAD6C\uB2E8\uC790. \uAD00\uC740 \uBC1B\uC544 \uC801\uAE30\uB9CC \uD588\uB2E4."
  _requiresMagnifier: 0
  _recordClue: 1
  _clueCase: 0
  _clueKey: G02
  _clueText: "[G02] \uAD00\uC544\uAC00 \uBC1B\uC544 \uB454 \uC62C\uD574 \uD638\uAD6C\uB2E8\uC790
    \u2014 \u300C\uC885 \uBCF5\uB3D9, \uC784\uC624\uB144 \uC720\uC6D4\uC5D0 \uC8FD\uC74C\u300D.
    \uAD00\uB9AC\uAC00 \uC870\uC0AC\uD574 \uC4F4 \uAC83\uC774 \uC544\uB2C8\uB77C
    <b>\uC9D1\uC5D0\uC11C \uC368 \uC62C\uB9B0 \uAC83</b>\uC744 \uBC1B\uC544 \uB454
    \uAC83\uC774\uB2E4."
  _clueImage: {fileID: 0}
