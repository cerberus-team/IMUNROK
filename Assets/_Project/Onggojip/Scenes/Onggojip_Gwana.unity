--- !u!114 &377285328
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 377285326}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6b8e8c95a8470bf4eb8d40d4c9e925c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: IMUNROK.Common::IMUNROK.Common.InspectableNote
  _page: {fileID: 2800000, guid: dc97cb99e29d4b8419e3268c61a08ba6, type: 3}
  _canOpen: 1
  _maxTouchDistance: 3
  _fineText: "\uB05D\uC904(\uB2E4\uC12F\uC9F8 \uC904)\uB9CC \uBA39\uBE5B\uC774 \uC605\uB2E4.
    \uD68D \uB05D\uC774 \uBB49\uAC1C\uC9C0\uACE0 \uC885\uC774 \uACB0\uC774 \uC77C\uC5B4\uB098
    \uC788\uB2E4 \u2014 *\uAE01\uC5B4\uB0B4\uACE0 \uADF8 \uC704\uC5D0 \uB367\uC4F4*
    \uC790\uB9AC\uB2E4."
  _clueNeedsMagnifier: 0
  _dimBehind: 1
  _clueNoteAfterMagnify: "\uB3CB\uBCF4\uAE30\uB85C \uBCF4\uB2C8 \u2014 \uB05D\uC904(\uB2E4\uC12F\uC9F8
    \uC904) \u300C\uBA74\uCC9C \uC5C6\uC74C\u300D\uB9CC \uBA39\uBE5B\uC774 \uC605\uACE0
    \uC885\uC774 \uACB0\uC774 \uC77C\uC5B4\uB098 \uC788\uB2E4. <b>\uAE01\uC5B4\uB0B4\uACE0
    \uADF8 \uC704\uC5D0 \uB367\uC4F4</b> \uC790\uB9AC\uB2E4. \uBB34\uC5C7\uC744 \uAE01\uC5B4\uB0C8\uB294\uC9C0\uB294
    \uBD88\uBE5B\uC5D0 \uBE44\uCDB0 \uBD10\uC57C \uBCF4\uC774\uACA0\uB2E4."
  _model: {fileID: 0}
  _modelEuler: {x: 0, y: 0, z: 0}
  _pageKo: {fileID: 2800000, guid: ddb26c920f5a6184ea08912e7c12eaa6, type: 3}
  _revealsPressed: {fileID: 0}
  _backPage: {fileID: 2800000, guid: 2d73e7a98cbf6eb45858029e08a9eb5b, type: 3}
  _litPage: {fileID: 2800000, guid: 607c8321a128a4e44b20e656b676fcfb, type: 3}
  _litText: "\uAE01\uC5B4\uB0B8 \uC790\uB9AC \uBC11\uC5D0\uC11C \uBA3C\uC800 \uC4F4
    \uAE00\uC774 \uBC30\uC5B4 \uB098\uC628\uB2E4 \u2014 *\u300C\uBA74\uCC9C(\u514D\u8CE4),
    \uAE30\uBB18\uB144 \uC2DC\uC6D4\u300D*. \uC774 \uC904\uC740 \uC6D0\uB798 \u300E\uBA74\uCC9C
    \uC5C6\uC74C\u300F\uC774 \uC544\uB2C8\uC5C8\uB2E4."
  _clueNeedsLantern: 0
  _litGlyphs: "\u514D\u8CE4"
  _litClueKey: G11
  _litClueOwnText: "[G11] \uC785\uC548\uB300\uC7A5 \uB05D\uC904\uC758 \uC9C0\uC6B4
    \uBC11\uAE00 \u2014 \u300C\uBA74\uCC9C, \uAE30\uBB18\uB144 \uC2DC\uC6D4\u300D.
    \uB204\uAD70\uAC00 \uAE01\uC5B4\uB0B4\uACE0 \u300C\uBA74\uCC9C \uC5C6\uC74C\u300D\uC73C\uB85C
    \uB367\uC37C\uB2E4."
  _litClueText: "[G03] \uC785\uC548\uB300\uC7A5(\u7ACB\u6848\u5927\u5E33) \u2014
    \uC0AC\uC0AC\uB85C\uC774 \uC8FC\uACE0\uBC1B\uC740 \uBB38\uC11C\uB97C \uAD00\uC774
    \uC0B4\uD3B4 \uD655\uC778\uD558\uACE0 \uB3C4\uC7A5\uC744 \uCC0D\uC5B4 \uC900
    \uAE30\uB85D\uC744 \uBAA8\uC740 \uCC45\uC774\uB2E4. \uBB38\uC11C\uACE0 \uADA4
    \uC548\uC5D0 \uB4E4\uC5B4 \uC788\uC5C8\uB2E4.\n\n\uC639\uC528 \uC9D1\uC548\uC758
    \uAC83\uC774 \uD55C \uAC74 \uC2E4\uB824 \uC788\uB2E4.\n\xB7 \uC784\uC220\uB144
    \uC815\uC6D4 \uC785\uC548 \u2014 \uC639\uC528 \uBCC4\uAE09\uBB38\uAE30 \uD55C
    \uD1B5\n\xB7 \uBC1B\uC740 \uC774 \u300C\uC624\uB798 \uBD80\uB9B0 \uC885 \uBCF5\uB3D9\u300D\n\xB7
    \uB17C \uC5EC\uB35F \uB9C8\uC9C0\uAE30, \uB178\uBE44 \uB450 \uC0AC\uB78C\n\xB7
    \uB05D\uC904 \u300C\uBA74\uCC9C(\u514D\u8CE4) \uC5C6\uC74C\u300D\n\n\uAD00\uC758
    \uCC45\uC5D0 \uC774\uB807\uAC8C \uB0A8\uC544 \uC788\uB294 \uD55C, \uBCF5\uB3D9\uC740
    \uC7AC\uC0B0\uC744 \uBC1B\uC558\uC5B4\uB3C4 \uC2E0\uBD84\uC740 \uC885\uC774\uB2E4.\n\n\uB3CB\uBCF4\uAE30\uB85C
    \uBCF4\uB2C8 \u2014 \uB05D\uC904(\uB2E4\uC12F\uC9F8 \uC904) \u300C\uBA74\uCC9C
    \uC5C6\uC74C\u300D\uB9CC \uBA39\uBE5B\uC774 \uC605\uACE0 \uC885\uC774 \uACB0\uC774
    \uC77C\uC5B4\uB098 \uC788\uB2E4. <b>\uAE01\uC5B4\uB0B4\uACE0 \uADF8 \uC704\uC5D0
    \uB367\uC4F4</b> \uC790\uB9AC\uB2E4. \uBB34\uC5C7\uC744 \uAE01\uC5B4\uB0C8\uB294\uC9C0\uB294
    \uBD88\uBE5B\uC5D0 \uBE44\uCDB0 \uBD10\uC57C \uBCF4\uC774\uACA0\uB2E4.\n\n\uBD88\uBE5B\uC5D0
    \uBE44\uCD94\uB2C8 \u2014 \uAE01\uD78C \uC790\uB9AC \uBC11\uC5D0 \uBA3C\uC800
    \uC4F4 \uAE00\uC774 \uBC30\uC5B4\uB09C\uB2E4. \u300C<b>\uBA74\uCC9C, \uAE30\uBB18\uB144
    \uC2DC\uC6D4</b>\u300D. \uBCF5\uB3D9\uC740 \uAE30\uBB18\uB144 \uC2DC\uC6D4\uC5D0
    \uC774\uBBF8 \uC885\uC5D0\uC11C \uD480\uB824\uB09C \uBAB8\uC774\uC5C8\uB2E4.\n\uADF8\uB7F0\uB370
    \uC774 \uC785\uC548\uC758 \uC6D0\uB798 \uC7A5\uC774 \uC5C6\uB2E4 \u2014 \uBB36\uC74C\uC2E4
    \uACC1\uC5D0 \uD55C \uC7A5\uC774 \uB72F\uACA8 \uB098\uAC04 \uC790\uAD6D\uC774
    \uB0A8\uC558\uB2E4. \uB72F\uC5B4\uB0B8 \uC7A5\uC740 \uC774 \uBB38\uC11C\uACE0
    \uC5B4\uB518\uAC00\uC5D0 \uC788\uC744\uC9C0 \uBAA8\uB978\uB2E4."
  _title: "\uC785\uC548\uB300\uC7A5"
  _body: "\uAD00\uC774 \uD655\uC778\uD574 \uB3C4\uC7A5\uC744 \uCC0D\uC5B4 \uC900
    \uBB38\uC11C\uB4E4\uC758 \uAE30\uB85D. \uC639\uC528 \uC9D1\uC548 \uBCC4\uAE09\uBB38\uAE30\uC758
    \uC0AC\uBCF8\uC774 \uC2E4\uB824 \uC788\uB2E4."
  _requiresMagnifier: 0
  _recordClue: 1
  _clueCase: 0
  _clueKey: G03
  _clueText: "[G03] \uC785\uC548\uB300\uC7A5(\u7ACB\u6848\u5927\u5E33) \u2014 \uC0AC\uC0AC\uB85C\uC774
    \uC8FC\uACE0\uBC1B\uC740 \uBB38\uC11C\uB97C \uAD00\uC774 \uC0B4\uD3B4 \uD655\uC778\uD558\uACE0
    \uB3C4\uC7A5\uC744 \uCC0D\uC5B4 \uC900 \uAE30\uB85D\uC744 \uBAA8\uC740 \uCC45\uC774\uB2E4.
    \uBB38\uC11C\uACE0 \uADA4 \uC548\uC5D0 \uB4E4\uC5B4 \uC788\uC5C8\uB2E4.\n\n\uC639\uC528
    \uC9D1\uC548\uC758 \uAC83\uC774 \uD55C \uAC74 \uC2E4\uB824 \uC788\uB2E4.\n\xB7
    \uC784\uC220\uB144 \uC815\uC6D4 \uC785\uC548 \u2014 \uC639\uC528 \uBCC4\uAE09\uBB38\uAE30
    \uD55C \uD1B5\n\xB7 \uBC1B\uC740 \uC774 \u300C\uC624\uB798 \uBD80\uB9B0 \uC885
    \uBCF5\uB3D9\u300D\n\xB7 \uB17C \uC5EC\uB35F \uB9C8\uC9C0\uAE30, \uB178\uBE44
    \uB450 \uC0AC\uB78C\n\xB7 \uB05D\uC904 \u300C\uBA74\uCC9C(\u514D\u8CE4) \uC5C6\uC74C\u300D\n\n\uAD00\uC758
    \uCC45\uC5D0 \uC774\uB807\uAC8C \uB0A8\uC544 \uC788\uB294 \uD55C, \uBCF5\uB3D9\uC740
    \uC7AC\uC0B0\uC744 \uBC1B\uC558\uC5B4\uB3C4 \uC2E0\uBD84\uC740 \uC885\uC774\uB2E4."
  _clueImage: {fileID: 0}
