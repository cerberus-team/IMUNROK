--- !u!114 &42888057
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 42888052}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6b8e8c95a8470bf4eb8d40d4c9e925c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: IMUNROK.Common::IMUNROK.Common.InspectableNote
  _page: {fileID: 2800000, guid: c64c9d4b6f38b694f8ee0266070e1156, type: 3}
  _canOpen: 1
  _maxTouchDistance: 3
  _fineText: "\uC81C\uC0AC(\u984C\u8FAD) \uACC1\uC5D0 \uCC98\uACB0\uD55C \uAE30\uB85D\uC774
    \uC5C6\uB2E4. \uBC1B\uC544 \uB450\uAE30\uB9CC \uD588\uB2E4."
  _clueNeedsMagnifier: 0
  _dimBehind: 1
  _clueNoteAfterMagnify: "\uB3CB\uBCF4\uAE30\uB85C \uBCF4\uB2C8 \u2014 \uC18C\uC9C0\uB97C
    \uBC1B\uACE0\uB3C4 \uCC98\uACB0\uD55C \uAE30\uB85D\uC774 \uC5C6\uB2E4. \uD55C
    \uD574\uAC00 \uB118\uB3C4\uB85D \uAC11\uB9AC\uAC00 \uADF8\uB300\uB85C \uC774\uC5B4\uC84C\uB2E4."
  _model: {fileID: 0}
  _modelEuler: {x: 0, y: 0, z: 0}
  _pageKo: {fileID: 2800000, guid: c7470564f339f0347b162906b0587e60, type: 3}
  _revealsPressed: {fileID: 0}
  _backPage: {fileID: 2800000, guid: c9dcea18895c41e4ebdb9fcb7408cffb, type: 3}
  _litPage: {fileID: 0}
  _litText: 
  _clueNeedsLantern: 0
  _litGlyphs: 
  _litClueKey: 
  _litClueOwnText: 
  _litClueText: 
  _title: "\uC18C\uC9C0(\u6240\u5FD7)"
  _body: "\uD658\uC0C1\uB300\uC7A5 \uBC11\uC5D0 \uB07C\uC6CC \uB454 \uBC31\uC131\uB4E4\uC758
    \uD638\uC18C\uBB38. \uAD00\uC758 \uC81C\uC0AC(\u984C\u8FAD)\uAC00 \uC801\uD600
    \uC788\uB2E4."
  _requiresMagnifier: 0
  _recordClue: 1
  _clueCase: 0
  _clueKey: G14
  _clueText: "[G14] \uC18C\uC9C0(\u6240\u5FD7) \u2014 \uC791\uB144(\uC2E0\uC0AC\uB144)
    \uC0BC\uC6D4 \uC639\uB2F9\uCD0C \uBC31\uC131\uB4E4\uC774 \uAD00\uC5D0 \uC62C\uB9B0
    \uD638\uC18C\uBB38. \u300C\uC639\uB355\uAD6C\uAC00 \uC7A5\uB9AC\uC300\uC744 \uD574\uB9C8\uB2E4
    \uC5F4 \uD560 \uC774\uC790\uB85C \uB193\uC544, \uC800\uD76C\uAC00 \uAC1A\uC9C0
    \uBABB\uD558\uACE0 \uB5A0\uB3CC\uAC8C \uB418\uC5C8\uC0AC\uC624\uB2C8\u300D. \uAD00\uC740
    \u300C\uC0AC\uC2E4\uC744 \uC0B4\uD3B4 \uCC98\uACB0\uD560 \uAC83\u300D\uC774\uB77C
    \uC801\uACE0 \uB36E\uC5C8\uB2E4."
  _clueImage: {fileID: 0}
