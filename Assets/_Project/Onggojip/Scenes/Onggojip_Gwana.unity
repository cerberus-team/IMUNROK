  _clueNoteAfterMagnify: "\uB3CB\uBCF4\uAE30\uB85C \uBCF4\uB2C8 \u2014 \uC18C\uC791\uB8CC\uB97C
    \uAC10\uD574 \uB2EC\uB77C \uCCAD\uD55C \uC218\uACB0\uC774 \uC720\uC6D4\uBD80\uD130
    \uB2EC\uB77C\uC84C\uB2E4. \uC0C8 \uC8FC\uC778\uC774 \uB4E4\uC5B4\uC549\uC740
    \uB2EC\uBD80\uD130 \uB9C8\uC744 \uC778\uC2EC\uC744 \uC0AC\uB824 \uD55C \uC148\uC774\uB2E4."
  _model: {fileID: 0}
  _modelEuler: {x: 0, y: 0, z: 0}
  _pageKo: {fileID: 2800000, guid: b1ed250201a71ab4185721f3b46aaa2a, type: 3}
  _revealsPressed: {fileID: 0}
  _backPage: {fileID: 2800000, guid: 35a1bfb31e1955443b2567e1f428d623, type: 3}
  _litPage: {fileID: 0}
  _litText: 
  _clueNeedsLantern: 0
  _litGlyphs: 
  _litClueKey: 
  _litClueOwnText: 
  _litClueText: 
  _title: "\uD658\uACE1\uB300\uC7A5"
  _body: "\uD658\uACE1\uACFC \uC18C\uC791\uC744 \uC801\uC740 \uB300\uC7A5. \uD55C
    \uB2EC \uC804 \uC22B\uC790\uAC00 \uD55C \uBC88 \uAEBE\uC778\uB2E4."
  _requiresMagnifier: 0
  _recordClue: 1
  _clueCase: 0
  _clueKey: G04
  _clueText: "[G04] \uD658\uC0C1\uB300\uC7A5(\u9084\u4E0A\u5927\u5E33), \uC62C\uD574
    \uB109 \uB2EC\uCE58 \uC18C\uC791 \uAE30\uB85D. \uC0AC\uC6D4\xB7\uC624\uC6D4 \uC11C\uB978
    \uB9D0\uC774\uB358 \uC18C\uC791\uB8CC\uAC00 <b>\uC720\uC6D4\uBD80\uD130 \uC2A4\uBB34
    \uB9D0</b>\uB85C \uB0B4\uB838\uB2E4. \uB05D\uC904 \u2014 \u300C\uD638\uC8FC\uAC00
    \uAC10\uD574 \uB2EC\uB77C \uCCAD\uD568, \uADF8\uB300\uB85C \uC2DC\uD589\u300D."
  _clueImage: {fileID: 0}
