  m_Script: {fileID: 11500000, guid: a9fb1a4aa747ff04a9172ea84c2e06aa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: IMUNROK.Common::IMUNROK.Common.LightBeam
  _source: 1
  _dwellSeconds: 0.8
  _closeDoorsLine: "\uBD88\uBE5B\uC774 \uC0C8\uC9C0 \uC54A\uAC8C \uBB38\uC744 \uB2EB\uC558\uB2E4.
    \uC774\uC81C \uAC70\uC6B8\uB85C \uBD88\uBE5B\uC744 \uB3CC\uB824 \uBCFC \uC218
    \uC788\uB2E4."
  _aimLine: "\uB4F1\uBD88\uC744 \uC5B9\uC5C8\uB2E4. \uB4A4\uCABD \uC11C\uAC00 \uAC00\uC6B4\uB370
    \uCE78 \uD55C \uACF3\uB9CC \uBA3C\uC9C0\uAC00 \uD750\uD2B8\uB7EC\uC838 \uC788\uB2E4
    \u2014 \uB4F1\uACBD \uC790\uB9AC\uC640 \uB3D9\uACBD\uC758 \uAC01\uC744 \uB9DE\uCDB0
    \uBD88\uBE5B\uC744 \uADF8 \uCE78\uC5D0 \uC549\uD600 \uBCF4\uC790."
  _aimMark: "\uBA3C\uC9C0\uAC00 \uD750\uD2B8\uB7EC\uC9C4 \uCE78"
  _onFound:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 637591703}
        m_TargetAssemblyTypeName: IMUNROK.Common.DropFromShelf, IMUNROK.Common
        m_MethodName: Drop
        m_Mode: 0
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: 
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
  _sunward: {x: 0.3, y: -0.18, z: -1}
  _reach: 24
  _bounces: 3
  _mask:
    serializedVersion: 2
    m_Bits: 4294967295
  _width: 0.045
  _color: {r: 1, g: 0.93, b: 0.7, a: 0.55}
  _spotIntensity: 2.6
  _spotRange: 2.5
  _reveal: {fileID: 0}
  _keepOnceSeen: 1
  _title: "\uC11C\uAC00 \uD55C \uCE78"
  _bodyDark: "\uCC45\uACFC \uBB38\uC11C\uAC00 \uBE7D\uBE7D\uD55C \uCE78\uC774\uB2E4.
    \uC774 \uCE78\uB9CC \uBA3C\uC9C0\uAC00 \uD750\uD2B8\uB7EC\uC838 \uC788\uB2E4."
  _bodyFlood: "\uBB38\uC774 \uC5F4\uB824 \uBCD5\uC774 \uB4E4\uC5B4, \uB4F1\uBD88
    \uC904\uAE30\uAC00 \uD769\uC5B4\uC838 \uBC84\uB9B0\uB2E4 \u2014 \uBB38\uC744
    \uB2EB\uC544\uC57C \uD55C\uB2E4."
  _bodyMiss: "\uBD88\uBE5B \uC904\uAE30\uAC00 \uBC29\uC744 \uAC00\uB85C\uC9C0\uB978\uB2E4.
    \uB2E4\uB9CC \uC774 \uCE78\uC5D0\uB294 \uB2FF\uC9C0 \uC54A\uB294\uB2E4."
  _bodyHit: "\uBD88\uBE5B\uC774 \uCE78 \uAE4A\uC219\uC774 \uB4E4\uC790, \uCC45 \uB4A4\uC5D0
    \uBC00\uC5B4 \uB123\uC740 \uC885\uC774 \uB05D\uC774 \uB4DC\uB7EC\uB09C\uB2E4."
