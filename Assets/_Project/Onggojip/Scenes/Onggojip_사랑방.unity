  m_Name: 
  m_EditorClassIdentifier: IMUNROK.Common::IMUNROK.Common.InspectableNote
  _page: {fileID: 2800000, guid: 1cc41d64a2ca5e842b7f459b07ab6b6d, type: 3}
  _canOpen: 1
  _maxTouchDistance: 3
  _fineText: "\uBCBC \uC5F4 \uC12C\uC744 \uBE4C\uB9AC\uACE0 \uD574\uB9C8\uB2E4 \uC5F4
    \uC12C\uC744 \uB354 \uC5B9\uB294\uB2E4 \u2014 \uD55C \uD574\uC5D0 \uACF1\uC774
    \uB418\uB294 \uAC11\uB9AC(\u7532\u5229)\uB2E4. \u671F\uB97C \uB118\uAE30\uBA74
    \uB17C\uBC2D\uC73C\uB85C \uB300\uB0A9."
  _clueNeedsMagnifier: 1
  _title: "\uCC28\uC6A9\uC99D"
  _body: "\uC639\uB355\uAD6C\uAC00 \uB0A8\uC5D0\uAC8C \uBCBC\uB97C \uAFB8\uC5B4 \uC8FC\uBA70
    \uBC1B\uC544 \uB454 \uC99D\uC11C\uB2E4."
  _requiresMagnifier: 0
  _recordClue: 1
  _clueCase: 0
