  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6b8e8c95a8470bf4eb8d40d4c9e925c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: IMUNROK.Common::IMUNROK.Common.InspectableNote
  _page: {fileID: 2800000, guid: bd70dc3b94cfe7b40ac910d17fa614d1, type: 3}
  _canOpen: 1
  _maxTouchDistance: 3
  _fineText: "\u5974 \u535C\u540C \u8F9B\u672A\u5E74 \u6B7B\u4EA1 \u2014 \uBCF5\uB3D9\uC774
    \uC8FD\uC740 \uAC83\uC73C\uB85C \uC801\uD600 \uC788\uB2E4. \uD638\uC801\uB300\uC7A5\uACFC
    \uD544\uC801\uC774 \uB2E4\uB974\uB2E4. \uAD00\uB9AC\uAC00 \uC544\uB2C8\uB77C
    \uC774 \uC9D1 \uC0AC\uB78C\uC758 \uC190\uC774\uB2E4."
  _clueNeedsMagnifier: 0
  _title: "\uD638\uAD6C\uB2E8\uC790(\u6236\u53E3\u55AE\u5B50)"
  _body: "\uC62C\uD574 \uC2DD\uB144\uC5D0 \uC0C8\uB85C \uB0B8 \uD638\uAD6C\uB2E8\uC790\uB2E4."
  _requiresMagnifier: 0
  _recordClue: 1
  _clueCase: 0
  _clueKey: J17
  _clueText: "[J17] \uC62C\uD574 \uB0B8 \uAC83\uC774\uB2E4. \uB178 \uBCF5\uB3D9\uC774
    \uC2E0\uBBF8\uB144\uC5D0 \uC8FD\uC5C8\uB2E4\uACE0 \uC801\uD600 \uC788\uB294\uB370,
    \uAE00\uC528\uAC00 \uAD00\uB9AC\uC758 \uAC83\uC774 \uC544\uB2C8\uB2E4"
  _clueImage: {fileID: 0}
