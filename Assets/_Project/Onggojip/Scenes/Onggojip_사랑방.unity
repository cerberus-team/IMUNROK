  m_Script: {fileID: 11500000, guid: 6b8e8c95a8470bf4eb8d40d4c9e925c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: IMUNROK.Common::IMUNROK.Common.InspectableNote
  _page: {fileID: 2800000, guid: f315f37614209374eaf462cb53dfa7bd, type: 3}
  _canOpen: 1
  _maxTouchDistance: 3
  _fineText: "\u5974 \u535C\u540C \u5E74 \u4E09\u5341\u516B \u2014 \uC885 \uBCF5\uB3D9\uC774
    \uC0B4\uC544 \uC788\uB294 \uAC83\uC73C\uB85C \uC62C\uB77C \uC788\uB2E4. \uBC18\uB4EF\uD55C
    \uD55C \uC190, \uAD00\uB9AC\uC758 \uAE00\uC528\uB2E4."
  _clueNeedsMagnifier: 1
  _title: "\uD638\uC801\uB300\uC7A5(\u6236\u7C4D\u5927\u5E33)"
  _body: "\uC0BC \uB144 \uC804 \uAD00\uAC00\uAC00 \uAC00\uC9C0\uACE0 \uC788\uB294
    \uD638\uC801\uC774\uB2E4."
  _requiresMagnifier: 0
  _recordClue: 1
  _clueCase: 0
  _clueKey: J12
  _clueText: "[J12] \uC0BC \uB144 \uC804 \uD638\uC801\uC774\uB2E4. \uB178 \uBCF5\uB3D9\uC774
    \uC0B4\uC544 \uC788\uB2E4\uACE0 \uC801\uD600 \uC788\uB2E4"
