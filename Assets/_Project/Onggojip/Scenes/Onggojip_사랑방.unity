  _ember: {fileID: 0}
  _emberBoost: 2.2
  _boostSeconds: 0
  _title: "\uBCF4\uB8CC"
  _bodyBefore: "\uC8FC\uC778\uC774 \uC549\uC544 \uC788\uB358 \uC790\uB9AC\uB2E4."
  _bodyAfter: "\uBC11\uC5D0 \uBCC4\uAE09\uBB38\uAE30 \uD55C \uC7A5\uC774 \uAE54\uB824
    \uC788\uB2E4."
  _hint: "(\uB20C\uB7EC \uC7A1\uACE0 \uB4E4\uCD94\uAE30)"
  _recordClue: 1
  _clueCase: 0
  _clueKey: J11
  _clueText: "[J11] \uBCF4\uB8CC \uBC11 \uBCC4\uAE09\uBB38\uAE30. \uC7AC\uC0B0\uC744
    '\uC624\uB798 \uBD80\uB9B0 \uC885 \uBCF5\uB3D9\uC5D0\uAC8C' \uC900\uB2E4 \u2014
    \uC544\uB4E4\uC774\uB77C\uB294 \uB9D0\uC774 \uC5C6\uB2E4."
  _clueImage: {fileID: 0}
  _cluePage: {fileID: 2800000, guid: 026958a115f7a0d4a97fc756841adada, type: 3}
  _clueName: 
  _clueFine: "\u4E45\u4F7F\u5974 \u535C\u540C \u8655 \u2014 '\uC624\uB798 \uBD80\uB9B0
    \uC885 \uBCF5\uB3D9\uC5D0\uAC8C' \uC900\uB2E4. \uC544\uB4E4\uC774\uB77C \uC801\uC9C0
    \uC54A\uC558\uACE0 \uBA74\uCC9C\uD55C\uB2E4\uB294 \uB9D0\uB3C4 \uC5C6\uB2E4.
    \uC7AC\uC0B0\uC740 \uC8FC\uB418 \uC885\uC740 \uADF8\uB300\uB85C\uB2E4. \u8F9B\u672A\u5E74
    \u6B63\u6708 \u5B98\u7ACB\u6848."
  _onRaked:
    m_PersistentCalls:
      m_Calls: []
  _lockedAtStart: 1
  _lockedBody: "\uC8FC\uC778\uC774 \uADF8 \uC704\uC5D0 \uC549\uC544 \uC788\uB2E4."
