      propertyPath: _clueKey
      value: J06
      objectReference: {fileID: 0}
    - target: {fileID: 5260064872674817566, guid: 4546360fa5a3bcb4bb176b7ce25d7195, type: 3}
      propertyPath: _clueText
      value: "[J06] \uC2A4\uBB34 \uD574\uCE58 \uAE30\uB85D \uB4A4 \uCD5C\uADFC \uB450
        \uC904\uB9CC \uD544\uC801\uC774 \uB2E4\uB974\uB2E4"
      objectReference: {fileID: 0}
    - target: {fileID: 5260064872674817566, guid: 4546360fa5a3bcb4bb176b7ce25d7195, type: 3}
      propertyPath: _fineText
      value: "\u4E19\u5BC5\u5E74 \uB450 \uC904\uB9CC \uBD93\uB05D\uC774 \uB2E4\uB974\uB2E4.
        \uD68D\uC758 \uCCAB\uBA38\uB9AC\uAC00 \uBB34\uB514\uACE0 \uC090\uCE68\uC774
        \uC9E7\uB2E4 \u2014 \uC55E\uC758 \uC2A4\uBB34 \uD574\uC640 \uAC19\uC740 \uC190\uC774
        \uC544\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5260064872674817566, guid: 4546360fa5a3bcb4bb176b7ce25d7195, type: 3}
      propertyPath: _clueNeedsMagnifier
