  m_Name: 
  m_EditorClassIdentifier: IMUNROK.Common::IMUNROK.Common.PressedMarks
  _title: "\uB20C\uB9B0 \uC790\uAD6D"
  _readOut: "\u4E19\u5BC5\u5E74, \u79DF \u4E09\u5341\u77F3 \u2014 \uC7A5\uBD80\uC5D0
    \uC801\uD78C \uADF8 \uB450 \uC904\uC744 \uC5EC\uAE30 \uBA87 \uBC88\uC774\uB098
    \uB20C\uB7EC \uC368 \uBCF4\uC558\uB2E4."
  _recordClue: 1
  _clueCase: 0
  _clueKey: J06
  _clueText: "[J06] \uC2A4\uBB34 \uD574\uCE58\uAC00 \uD55C \uC190\uC73C\uB85C \uC801\uD788\uB2E4\uAC00,
    \uB9C8\uC9C0\uB9C9 \uB450 \uC904\uB9CC \uB2E4\uB978 \uC190\uC774\uB2E4. \uB9DE\uC740\uD3B8
    \uBC31\uC9C0\uC5D0\uB294 \uADF8 \uB450 \uC904\uC744 \uBBF8\uB9AC \uC5F0\uC2B5\uD55C
    \uC790\uAD6D\uC774 \uB20C\uB824 \uC788\uB2E4."
  _cluePage: {fileID: 2800000, guid: eb3ebdc161ff9cb4694f85fa720511af, type: 3}
  _alsoHide: []
