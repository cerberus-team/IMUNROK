--- !u!114 &1986024757
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1986024753}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6b8e8c95a8470bf4eb8d40d4c9e925c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: IMUNROK.Common::IMUNROK.Common.InspectableNote
  _page: {fileID: 2800000, guid: 026958a115f7a0d4a97fc756841adada, type: 3}
  _canOpen: 1
  _maxTouchDistance: 3
  _fineText: "\u4E45\u4F7F\u5974 \u535C\u540C \u8655 \u2014 '\uC624\uB798 \uBD80\uB9B0
    \uC885 \uBCF5\uB3D9\uC5D0\uAC8C' \uC900\uB2E4. \uC544\uB4E4\uC774\uB77C \uC801\uC9C0
    \uC54A\uC558\uACE0 \uBA74\uCC9C\uD55C\uB2E4\uB294 \uB9D0\uB3C4 \uC5C6\uB2E4.
    \uC7AC\uC0B0\uC740 \uC8FC\uB418 \uC885\uC740 \uADF8\uB300\uB85C\uB2E4. \u8F9B\u672A\u5E74
    \u6B63\u6708 \u5B98\u7ACB\u6848."
  _clueNeedsMagnifier: 1
  _title: "\uBCC4\uAE09\uBB38\uAE30(\u5225\u7D66\u6587\u8A18)"
  _body: "\uBCF4\uB8CC \uBC11\uC5D0 \uAE54\uB824 \uC788\uB358 \uC885\uC774\uB2E4.
    \uC544\uBC84\uC9C0\uAC00 \uC7AC\uC0B0\uC744 \uB118\uAE34 \uBB38\uC11C\uC778\uB370,
    \uBC1B\uB294 \uC774\uAC00 '\uC885'\uC73C\uB85C \uC801\uD600 \uC788\uB2E4."
  _requiresMagnifier: 0
  _recordClue: 0
  _clueCase: 0
  _clueKey: J11
  _clueText: "[J11] \uBCF4\uB8CC \uBC11\uC5D0 \uAE54\uB824 \uC788\uB358 \uC885\uC774\uB2E4.
    \uC7AC\uC0B0\uC744 \uB118\uAE34\uB2E4\uB294 \uBB38\uC11C\uC778\uB370, \uBC1B\uB294
    \uC774\uC758 \uC774\uB984\uC774 \uB0AF\uC124\uB2E4."
  _clueImage: {fileID: 0}
