  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6b8e8c95a8470bf4eb8d40d4c9e925c2, type: 3}
  m_Name: 
  m_EditorClassIdentifier: IMUNROK.Common::IMUNROK.Common.InspectableNote
  _page: {fileID: 2800000, guid: 206fbec17bf1a9b48afc30a1eb992528, type: 3}
  _canOpen: 1
  _maxTouchDistance: 2.5
  _fineText: "\uBC1B\uC744 \uACF3\uC774 \uC774 \uACE0\uC744\uC774 \uC544\uB2C8\uB2E4.
    \uAC1A\uC740 \uC790\uCDE8\uB3C4 \uC801\uD600 \uC788\uC9C0 \uC54A\uB2E4."
  _clueNeedsMagnifier: 1
  _title: "\uC218\uD45C(\u624B\u6A19)"
  _body: "\uC7A5 \uC548\uC5D0 \uB530\uB85C \uB123\uC5B4 \uB454 \uC99D\uC11C\uB2E4.
    \uB0A8\uC5D0\uAC8C \uAFB8\uC5B4 \uC900 \uB3C8\uC744 \uC544\uC9C1 \uBC1B\uC9C0
    \uBABB\uD588\uB2E4\uB294 \uD45C\uB2E4."
  _requiresMagnifier: 0
  _recordClue: 1
  _clueCase: 0
  _clueKey: J09
  _clueText: "[J09] \uC7A5 \uC548\uC5D0 \uB123\uC5B4 \uB454 \uC218\uD45C. \uBB34\uC7A5\uD604(\u8302\u9577\u7E23)
    \uBC15\uAC00\uC5D0\uAC8C \uC77C\uBC31 \uB0E5 \u2014 \uC0BC \uB144\uC774 \uB418\uB3C4\uB85D
    \uB4E4\uC5B4\uC624\uC9C0 \uC54A\uC558\uB2E4."
  _clueImage: {fileID: 0}
