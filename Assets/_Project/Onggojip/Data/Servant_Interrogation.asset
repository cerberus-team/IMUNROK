    \uC591\uBC18. \uC8FC\uBB34\uC154\uC57C\uC9C0\uC694."
  - "\uADF8\uB7F0 \uAC74 \uB098\uB9AC\uAED8 \uC5EC\uCB48\uC154\uC57C\u2026"
  mockDeflectAct2:
  - "\uC18C\uC778\uC740 \uC544\uBB34\uAC83\uB3C4 \uBAA8\uB985\uB2C8\uB2E4\uC694."
  - "\uB098\uB9AC, \uC18C\uC778\uC774 \uBB34\uC2A8 \uB0AF\uC73C\uB85C\u2026"
  - "\u2026\u2026."
  - "\uC18C\uC778\uC740 \uC2DC\uD0A4\uB294 \uB300\uB85C\uB9CC \uD588\uC2B5\uB2C8\uB2E4\uC694."
  openingLine: "\u2026\uB098\uADF8\uB124 \uC591\uBC18. \uC18C\uC778 \uAC19\uC740
    \uB299\uC740\uAC83\uC5D0\uAC8C \uBB34\uC2A8 \uBCFC\uC77C\uC774\u2026"
  openingLineAct2: "\u2026\uC5B4\uC0AC\uB610. \uC18C\uC778 \uAC19\uC740 \uB299\uC740
    \uC885\uC744 \uC608\uAE4C\uC9C0 \uBD80\uB974\uC2DC\uB2C8\u2026 \uBB34\uC5C7\uC744
    \uC544\uB8B0\uC624\uB9AC\uAE4C."
  recallLine: 
  closingLine: "\u2026\uC18C\uC778\uC740 \uC774\uB9CC \uBB3C\uB7EC\uAC00 \uBCF4\uACA0\uC2B5\uB2C8\uB2E4\uC694."
  closingLineAct2: "\u2026\uC18C\uC778\uC740 \uC544\uBB34\uAC83\uB3C4 \uBAA8\uB985\uB2C8\uB2E4\uC694.
    \uC815\uB9D0\uC774\uC62C\uC2DC\uB2E4."
  closingLineUntilClue: 
  closingLineAfter: 
  closingLineOnce: 0
  closingLineAgain: 
  calledUpLine: "\uC544\uC774\uAD6C, \uB098\uB9AC\u2026 \uC18C\uC778 \uAC19\uC740
    \uAC83\uC774 \uC5EC\uAE30\uC11C \uC785\uC744 \uB180\uB838\uB2E4\uAC00\uB294 \uC624\uB298
    \uBC24 \uB4F1\uC9DD\uC774 \uB0A8\uC544\uB098\uC9C8 \uC54A\uC2B5\uB2C8\uB2E4\uC694.
    *\uB3D9\uD5CC*\uC5D0\uC11C \uBD80\uB974\uC2DC\uBA74 \uADF8\uB54C \uC5EC\uCB59\uC9C0\uC694."
  topics:
  - act: 1
    question: 
    keywords: "\uBB50\uB77C \uBD80\uB974,\uC5B4\uCC0C \uBD80\uB974,\uC5B4\uB5BB\uAC8C
      \uBD80\uB974,\uD638\uCE6D,\uC8FC\uC778\uC744 \uBD80\uB974,\uC8FC\uC778 \uC591\uBC18\uC744,\uBD80\uB974\uC2DC\uC624"
    mockAnswer: "\uB098\u2026 \uB098\uB9AC\uAED8\uC11C\uB294\u2026 \uB098\uB9AC\uC2DC\uC9C0\uC694."
    grantsClueKey: J05
    grantsClueText: "\uC8FC\uC778\uC744 \uBB34\uC5B4\uB77C \uBD80\uB974\uB290\uB0D0
      \uBB3C\uC5C8\uB354\uB2C8 \u300C\uB098\u2026 \uB098\uB9AC\u2026\u300D \uD558\uACE0
      \uB9D0\uB05D\uC744 \uD750\uB838\uB2E4. \uD3C9\uC0DD\uC744 \uC774 \uC9D1\uC5D0\uC11C
      \uC0B0 \uC885\uC774 \uC81C \uC8FC\uC778\uC758 \uD638\uCE6D\uC5D0\uC11C \uD55C
      \uBC15\uC790 \uB2A6\uB294\uB2E4. \uBD80\uB974\uAE30 \uC5B4\uB824\uC6B4 \uAE4C\uB2ED\uC774
      \uC788\uB294 \uAC83\uC774\uB2E4."
    grantsClueTitle: "\uBA38\uBB47\uAC70\uB9AC\uB294 \uD638\uCE6D"
