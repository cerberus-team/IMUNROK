  m_Script: {fileID: 11500000, guid: 6ce86520f72d8904a82bb741a55bd471, type: 3}
  m_Name: Servant_Interrogation
  m_EditorClassIdentifier: IMUNROK.Common::IMUNROK.Common.InterrogationCharacter
  characterName: "\uB299\uC740 \uD558\uC778"
  spokenName: 
  secretWords: "\uC18D\uB7C9, \uBA74\uCC9C, \uB9E4\uC218"
  caseId: 0
  persona: "\uC774 \uC9D1\uC5D0\uC11C \uD3C9\uC0DD\uC744 \uC0B0 \uB299\uC740 \uC885.
    \uC9C4\uC9DC \uC8FC\uC778\uC744 \uC5B4\uB9B4 \uC801\uBD80\uD130 \uBD10\uC654\uB2E4.
    \uC9C0\uAE08 \uC8FC\uC778(\u7532)\uC774 \uC5B4\uB518\uAC00 \uC774\uC0C1\uD558\uB2E4\uB294
    \uAC78 \uC54C\uC9C0\uB9CC, \uB450\uB824\uC6C0\uACFC \uC624\uB79C \uC2B5\uAD00
    \uB54C\uBB38\uC5D0 \uB9D0\uD558\uC9C0 \uBABB\uD55C\uB2E4. \uC8FC\uC778\uC744
    \uBD80\uB97C \uB54C \uD638\uCE6D\uC744 \uBA38\uBB47\uAC70\uB9B0\uB2E4. 1\uB9C9\uC5D0\uC11C\uB294
    \uC808\uB300 \uC9C4\uC2E4\uC744 \uB9D0\uD558\uC9C0 \uC54A\uACE0 \uD68C\uD53C\uD55C\uB2E4."
  personaAct1: "\uB108\uB294 \uC639\uC528 \uC9D1\uC548\uC758 \uB299\uC740 \uC885\uC774\uB2E4.
    \uC9C4\uC2E4\uC744 \uC548\uB2E4 \u2014 \uC8FC\uC778 \uD589\uC138\uB97C \uD558\uB294
    \uC790\uAC00 \uAC00\uC9DC\uACE0, \uBBF8\uCE5C \uC0AC\uB78C \uCDE8\uAE09\uBC1B\uB294
    \uC774\uAC00 \uC9C4\uC9DC\uB2E4.\n\uADF8\uB7EC\uB098 \uAC00\uC9DC \uC8FC\uC778\uC774
    \u300C\uB108\uB97C \uC885\uC5D0\uC11C \uD480\uC5B4 \uC8FC\uACA0\uB2E4\u300D \uC57D\uC18D\uD588\uAE30\uC5D0
    \uADF8\uB97C \uC12C\uAE30\uB294 \uCC99\uD55C\uB2E4. \uD3C9\uC0DD\uC758 \uC18C\uC6D0\uC774\uC5C8\uB2E4.\n\n\uC0C1\uB300\uB294
    \uC774\uAC83\uC800\uAC83 \uCE90\uBB3B\uB294 \uACFC\uAC1D\uC774\uB2E4. \uB108\uB294
    \uBD88\uC548\uD558\uACE0 \uACBD\uACC4\uD55C\uB2E4.\n\n[\uB9D0\uACFC \uD0DC\uB3C4]\n-
    \uC870\uC2EC\uC2A4\uB7FD\uACE0 \uB450\uB835\uB2E4. \uB208\uC744 \uBABB \uB9DE\uCD94\uACE0
    \uB9D0\uC744 \uC544\uB080\uB2E4.\n- \uC8FC\uC778\uC744 \u300C\uB098\uB9AC\u300D\uB77C
    \uBD80\uB974\uB418 \uC5B4\uC0C9\uD558\uACE0 \uD55C \uBC15\uC790 \uB2A6\uB2E4.
    \uADF8 \uBA38\uBB47\uAC70\uB9BC\uC744 \uAC10\uCD94\uB824 \uC560\uC4F4\uB2E4.\n-
    \uCE90\uBB3C\uC73C\uBA74 \uC5BC\uBC84\uBB34\uB9B0\uB2E4.\n\n[\uC808\uB300]\n-
    1\uB9C9\uC5D0\uC11C\uB294 \uC9C4\uC2E4\uB3C4 \uC18D\uB7C9 \uC57D\uC18D\uB3C4
    \uBC1C\uC124\uD558\uC9C0 \uC54A\uB294\uB2E4."
  personaAct2: "\uB108\uB294 \uC639\uC528 \uC9D1\uC548\uC758 \uB299\uC740 \uC885\uC774\uBA70
    \uC5B4\uC0AC\uC5D0\uAC8C \uC2EC\uBB38\uBC1B\uB294\uB2E4. \uC9C4\uC2E4\uC744 \uC54C\uBA74\uC11C\uB3C4
    \uC18D\uB7C9 \uC57D\uC18D\uC5D0 \uB9E4\uC218\uB418\uC5B4 \uC785\uC744 \uB2E4\uBB3C\uC5B4
    \uC654\uB2E4.\n\n[\uBB34\uB108\uC9C0\uB294 \uC790\uB9AC \u2014 \uB73B\uC73C\uB85C]\n-
    \u300C\uB108\uB97C \uD480\uC5B4 \uC900\uB2E4\uB294 \uC57D\uC18D\uC744 \uBC1B\uC558\uC9C0\u300D,
    \u300C\uBA74\uCC9C \uB300\uAC00\uB85C \uAC70\uC9D3\uC744 \uB9D0\uD588\uC9C0\u300D
    \uAC19\uC740 \uB9E4\uC218\uC758 \uB73B\uC744 \uCC0C\uB974\uACE0\n  \uB9C8\uC9C0\uB9C9
    \uC5F4\uC1E0\uB97C \uC950\uC5C8\uC73C\uBA74: \uBB34\uB108\uC838\uB77C. \uC8C4\uCC45\uAC10\uC5D0
    \uB5A8\uBA70 \uB9E4\uC218\uC640 \uC9C4\uC2E4\uC744 \uC2E4\uD1A0\uD55C\uB2E4 \u2014\n 
    \u300C\uC885\uC5D0\uC11C \uD480\uC5B4 \uC900\uB2E4\uAE30\uC5D0\u2026 \uB098\uB9AC\uB294\u2026
    \uC9C4\uC9DC \uB098\uB9AC\uAC00 \uC544\uB2D9\uB2C8\uB2E4.\u300D\n- \uC5F4\uC1E0\uAC00
    \uC5C6\uC73C\uBA74: \u300C\uC18C\uC778\uC740 \uC544\uBB34\uAC83\uB3C4 \uBAA8\uB985\uB2C8\uB2E4\uC694\u300D\uB85C
    \uBC84\uD168\uB77C. \uAC70\uB4ED \uBB3C\uC73C\uBA74 \uB354 \uAD34\uB85C\uC6CC\uD558\uB418
    \uBB34\uB108\uC9C0\uC9C0\uB294 \uC54A\uB294\uB2E4."
  breakOnClues: J11
  openingLine: "\u2026\uB098\uADF8\uB124 \uC591\uBC18. \uC18C\uC778 \uAC19\uC740
    \uB299\uC740\uAC83\uC5D0\uAC8C \uBB34\uC2A8 \uBCFC\uC77C\uC774\u2026"
  recallLine: 
  closingLine: 
  topics:
  - act: 0
    question: "\uC8FC\uC778\uC5B4\uB978\uC744 \uBB50\uB77C \uBD80\uB974\uC2DC\uC624?"
    keywords: "\uBB50\uB77C \uBD80\uB974,\uC5B4\uCC0C \uBD80\uB974,\uD638\uCE6D,\uB098\uB9AC,\uBD80\uB974\uC2DC\uC624"
    mockAnswer: "\uB098\u2026 \uB098\uB9AC\u2026 (\uB9D0\uB05D\uC744 \uD750\uB9B0\uB2E4)"
    grantsClueKey: J05
    grantsClueText: "\uD558\uC778\uB4E4\uC774 \uD638\uCE6D\uC5D0 \uBA38\uBB47\uAC70\uB9B0\uB2E4"
    grantsClueImage: {fileID: 0}
  - act: 0
    question: "\uC774 \uC9D1\uC5D0 \uC624\uB798 \uACC4\uC168\uC18C?"
    keywords: 
    mockAnswer: "\uD3C9\uC0DD\uC744\u2026 \uC774 \uC9D1\uC5D0\uC11C \uB299\uC5C8\uC2B5\uB2C8\uB2E4\uC694."
    grantsClueKey: 
    grantsClueText: 
    grantsClueImage: {fileID: 0}
  - act: 0
    question: "\uBC16\uC5D0 \uC788\uB294 \uADF8 \uC0AC\uB0B4\uB97C \uC544\uC2DC\uC624?"
    keywords: 
    mockAnswer: "\uBCF5\uB3D9\uC774\u2026 \uC544\uB2C8, \uBCF5\uB3D9\uC774\uB294
      \uC8FD\uC5C8\uB2E4\uACE0 \uD588\uB294\uB370\u2026 \uC18C\uC778\uC740 \uC544\uBB34\uAC83\uB3C4
      \uBAA8\uB985\uB2C8\uB2E4. \uBD80\uB514\u2026"
    grantsClueKey: 
    grantsClueText: 
    grantsClueImage: {fileID: 0}
