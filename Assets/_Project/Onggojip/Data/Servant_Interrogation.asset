  - act: 1
    clueKey: J11
    clueText: "\uD589\uB791\uCC44 \uADA4 \u2014 \uC18D\uB7C9 \uBB38\uC11C"
    alsoNeedsClueKeys: 
    stageAtLeast: 0
    revealsInfo: "\uADF8\uAC74\u2026 \uC18C\uC778\uC740\u2026 \uBAA8\uB974\uB294
      \uC77C\uC785\uB2C8\uB2E4\u2026"
    keywords: 
