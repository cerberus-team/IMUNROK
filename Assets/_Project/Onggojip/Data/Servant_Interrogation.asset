    clueText: "\uBCF4\uB8CC \uBC11 \uBCC4\uAE09\uBB38\uAE30 \u2014 \uC218\uCDE8\uC778\uC774
      \u300C\uC624\uB798 \uBD80\uB9B0 \uC885 \uBCF5\uB3D9\u300D"
