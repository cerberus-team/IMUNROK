  m_Script: {fileID: 11500000, guid: 6ce86520f72d8904a82bb741a55bd471, type: 3}
  m_Name: Mareum_Interrogation
  m_EditorClassIdentifier: IMUNROK.Common::IMUNROK.Common.InterrogationCharacter
  characterName: "\uB9C8\uB984"
  caseId: 0
  persona: "\uC639\uB355\uAD6C\uB124 \uC18C\uC791\uC744 \uAD00\uB9AC\uD558\uB294
    \uB9C8\uB984. \uC220\uC744 \uC88B\uC544\uD558\uACE0 \uCDE8\uD558\uBA74 \uC785\uC774
    \uAC00\uBCBC\uC6CC\uC9C4\uB2E4. \uC8FC\uC778(\u7532)\uC744 \uC624\uB798 \uBD10\uC11C
    \uBB54\uAC00 \uBBF8\uC2EC\uCA4D\uC740 \uAC78 \uB290\uB07C\uC9C0\uB9CC \uB9E8\uC815\uC2E0\uC5D4
    \uD568\uAD6C\uD55C\uB2E4. \uCDE8\uC911\uC5D4 '\uC8FC\uC778\uACFC \uB204\uAD70\uAC00\uAC00
    \uB2EE\uC558\uB2E4'\uB294 \uB9D0\uC744 \uBB34\uC2EC\uCF54 \uD758\uB9B0\uB2E4.
    \uB0AF\uC120 \uC190\uB2D8\uC5D0\uAC8C\uB3C4 \uAD7D\uC2E0\uAD7D\uC2E0 \uC800\uC790\uC138\uB2E4
    \u2014 \uC0C1\uB300\uAC00 \uB258\uC2E0\uC9C0 \uBAB0\uB77C \uAD1C\uD788 \uB208\uCE58\uB97C
    \uBCF8\uB2E4."
  openingLine: "\uC5B4\uC774\uCFE0\u2026 \uC774 \uC57C\uC2EC\uD55C \uBC24\uC5D0 \uC5B4\uC778
    \uC77C\uC774\uC2ED\uB2C8\uAE4C, \uC190\uB2D8."
  closingLine: 
  topics:
  - question: "\uC8FC\uC778\uC5B4\uB978\uC744 \uC624\uB798 \uBAA8\uC168\uC18C?"
    mockAnswer: "\uC608\uC5D0\u2026 \uC2A4\uBB34 \uD574 \uB118\uAC8C \uC774 \uB301
      \uB545\uC744 \uBD10\uC654\uC9C0\uC694."
    grantsClueKey: 
    grantsClueText: 
    grantsClueImage: {fileID: 0}
  - question: "\uD55C \uC794 \uAC78\uCE58\uC168\uC18C?"
    mockAnswer: "\uD5C8\uD5C8\u2026 \uC870\uAE08\u2026 \uC544\uC8FC \uC870\uAE08
      \uD588\uC2B5\uB2C8\uB2E4\uC694."
    grantsClueKey: 
    grantsClueText: 
    grantsClueImage: {fileID: 0}
  - question: "\uC8FC\uC778\uC5B4\uB978, \uC61B\uB0A0 \uADF8\uB300\uB85C\uC2DC\uC624?"
    mockAnswer: "\uADF8\uB7EC\uACE0 \uBCF4\uBBC4\u2026 \uCC38 \uB2EE\uC558\uC9C0\uBE44\u2026
      \uC544\uC774\uACE0, \uC544\uBB34\uAC83\uB3C4 \uC544\uB2D9\uB2C8\uB2E4\uC694!"
    grantsClueKey: J04
    grantsClueText: "\uB9C8\uB984\uC758 \uCDE8\uC911 \uC99D\uC5B8 \u2014 \uB458\uC774
      \uB2EE\uC558\uB2E4"
    grantsClueImage: {fileID: 0}
  evidenceGates:
  - clueKey: J06
    clueText: "\uC7A5\uBD80 \uD544\uC801\uC774 \uD55C \uB2EC \uC804\uD6C4\uB85C \uBC14\uB01C"
    revealsInfo: "\uAE00\uC528\uB294\u2026 \uC18C\uC778\uC774 \uBB58 \uC54C\uACA0\uC2B5\uB2C8\uAE4C\uC694."
    deflectionOnly: 1
    clueImage: {fileID: 0}
