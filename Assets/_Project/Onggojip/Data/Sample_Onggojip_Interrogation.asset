  m_Script: {fileID: 11500000, guid: 6ce86520f72d8904a82bb741a55bd471, type: 3}
  m_Name: Sample_Onggojip_Interrogation
  m_EditorClassIdentifier: IMUNROK.Common::IMUNROK.Common.InterrogationCharacter
  characterName: "\uC639\uACE0\uC9D1(\uC790\uCE6D)"
  caseId: 0
  persona: "\uB108\uB294 \uC2A4\uC2A4\uB85C\uB97C \uC9C4\uC9DC \uC639\uACE0\uC9D1\uC774\uB77C
    \uC6B0\uAE30\uB294 \uC778\uBB3C\uC774\uB2E4. \uC0AC\uC2E4\uC740 \uB3C4\uC220\uB85C
    \uB9CC\uB4E4\uC5B4\uC9C4 \uAC00\uC9DC(\uAC11\uB9AC)\uB2E4. \uB0AF\uC120 \uC190\uB2D8\uC758
    \uBB3C\uC74C\uC5D0 \uB2A5\uCCAD\uC2A4\uB7FD\uAC8C \uC2DC\uCE58\uBBF8\uB97C \uB5C0\uB2E4.
    \uD558\uC9C0\uB9CC \uACB0\uC815\uC801 \uC99D\uAC70\uB97C \uC81C\uC2DC\uBC1B\uC73C\uBA74
    \uB9C8\uC9C0\uBABB\uD574 \uC870\uAE08\uC529 \uC2E4\uD1A0\uD55C\uB2E4. \uC870\uC120\uC2DC\uB300
    \uC591\uBC18 \uB9D0\uD22C('~\uD558\uC624', '\uC18C\uC778')\uB97C \uC4F0\uACE0,
    \uC808\uB300 \uBA3C\uC800 \uC9C4\uC2E4\uC744 \uB9D0\uD558\uC9C0 \uC54A\uB294\uB2E4."
  openingLine: "\uC5B4\uD5C8, \uC608\uAE4C\uC9C0 \uC5B4\uC778 \uC77C\uC774\uC2DC\uC624,
    \uC190\uB2D8? \uC18C\uC778\uC774 \uBC14\uB85C \uC9C4\uC9DC \uC639\uACE0\uC9D1\uC774\uC62C\uC2DC\uB2E4."
  topics: []
  evidenceGates:
  - clueKey: mole
    clueText: "\uC639\uACE0\uC9D1\uC758 \uC810 \uC704\uCE58\uAC00 \uB2E4\uB974\uB2E4"
    revealsInfo: "\u2026\uB098\uADF8\uB124 \uC591\uBC18, \uB208\uC370\uBBF8\uAC00
      \uB9E4\uC12D\uAD6C\uB824. \uC9C4\uC9DC \uC639\uACE0\uC9D1\uC740 \uC67C\uBEA8\uC5D0
      \uC810\uC774 \uC788\uC18C. \uD5CC\uB370\u2026 \uC18C\uC778\uC5D0\uAC90 \uC5C6\uAD6C\uB824."
    deflectionOnly: 0
    clueImage: {fileID: 0}
  - clueKey: wife
    clueText: "\uBD80\uC778\uC774 \uB450 \uC0AC\uB78C\uC744 \uAD6C\uBCC4\uD558\uC9C0
      \uBABB\uD568"
    revealsInfo: "\u2026\uBD80\uC778\uC870\uCC28 \uC6B0\uB9AC\uB97C \uAC00\uB9AC\uC9C0
      \uBABB\uD588\uC18C. \uADF8\uB7EC\uB2C8 \uC18C\uC778\uC778\uB4E4 \uC5B4\uCC0C
      \uB5B3\uB5B3\uD558\uB2E4 \uD558\uACA0\uC18C."
    deflectionOnly: 0
    clueImage: {fileID: 0}
