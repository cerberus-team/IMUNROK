  openingLine: "\uB258\uC2E0\uC9C0\uC694\u2026 \uC774 \uB2A6\uC740 \uBC24\uC5D0?"
  topics:
  - question: "\uC800 \uB301 \uC8FC\uC778\uC774 \uB204\uAD6C\uC694?"
    mockAnswer: "\uC639\uB355\uAD6C \uB098\uB9AC\uC2DC\uC9C0\uC694. \uC628 \uB9C8\uC744\uC774
      \uB2E4 \uC544\uB294 \uC5B4\uB978\uC785\uB2C8\uB2E4."
    grantsClueKey: J02
    grantsClueText: "\uB9C8\uC744 \uC0AC\uB78C\uB4E4\uC740 \u7532\uC744 \uC9C4\uC9DC\uB77C
      \uC5EC\uAE34\uB2E4"
    grantsClueImage: {fileID: 0}
  - question: "\uC800\uAE30 \uC800 \uC0AC\uB0B4\uB294?"
    mockAnswer: "\uC544\uC774\uACE0, \uC800 \uBBF8\uCE5C\uAC83\u2026 \uC0C1\uB300
      \uB9C8\uC2ED\uC2DC\uC624."
    grantsClueKey: J01
    grantsClueText: "\u4E59\uC774 \uB9C8\uC744\uC5D0\uC11C \uBBF8\uCE5C \uC0AC\uB78C
