  characterName: "\uB9C8\uC744 \uC0AC\uB78C"
  caseId: 0
  persona: "\uD3C9\uBC94\uD55C \uB9C8\uC744 \uC0AC\uB78C. \u7532\uC744 \uC9C4\uC9DC
    \uC639\uB355\uAD6C \uB098\uB9AC\uB85C \uC54C\uACE0, \u4E59\uC744 \uBBF8\uCE5C
