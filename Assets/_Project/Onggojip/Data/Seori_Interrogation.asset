  mockDeflectAct2:
  - "\uBB38\uC11C\uB294 \uBB38\uC11C\uACE0\uC5D0 \uC788\uC2B5\uC9C0\uC694. \uADA4\uB9C8\uB2E4
    \uB300\uC7A5\uC774 \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4."
  - "\uD310\uB2E8\uC740 \uC5B4\uC0AC\uAED8\uC11C \uD558\uC2E4 \uC77C\uC774\uC635\uB2C8\uB2E4."
  - "\uC0AC\uB78C\uC740 \uB3D9\uD5CC\uC5D0 \uC549\uC73C\uC2DC\uC5B4 \uBD80\uB974\uC2DC\uBA74
    \uD55C \uC0AC\uB78C\uC529 \uC62C\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
  openingLine: "\uC608, \uC5B4\uC0AC\uB610. \uBB34\uC5C7\uC744 \uCC3E\uC544 \uB4DC\uB9B4\uAE5D\uC1FC."
  openingLineAct2: "\uC608, \uC5B4\uC0AC\uB610. \uD558\uBB38\uD558\uC2ED\uC2DC\uC624.
    \uC18C\uC778\uC774 \uC544\uB294 \uB370\uAE4C\uC9C0 \uC544\uB8B0\uACA0\uC2B5\uB2C8\uB2E4."
  recallLine: "\uC608\uC608, \uB610 \uBB34\uC5C7\uC744 \uCC3E\uC73C\uC2ED\uB2C8\uAE4C."
  closingLine: "\uBB38\uC11C\uACE0\uB294 \uC800 \uC544\uB798\uC62C\uC2DC\uB2E4. \uC885\uC774
    \uB354\uBBF8\uAC00 \uC880 \uC5B4\uC218\uC120\uD569\uB2C8\uB2E4\uB9CC\u2026"
  closingLineAct2: "\uD310\uB2E8\uC740 \uC5B4\uC0AC\uAED8\uC11C \uD558\uC2E4 \uC77C\uC774\uC635\uB2C8\uB2E4.
    \uC18C\uC778\uC740 \uBB38\uC11C\uB098 \uCC59\uAE30\uACA0\uC2B5\uB2C8\uB2E4."
  closingLineUntilClue: 
  closingLineAfter: 
  closingLineOnce: 0
  closingLineAgain: 
  calledUpLine: "\uC18C\uC778\uC740 \uC5EC\uAE30 \uC11C\uC11C \uB300\uB839\uD558\uACE0
    \uC788\uACA0\uC2B5\uB2C8\uB2E4. \uD558\uBB38\uD558\uC2E4 \uC77C\uC740 *\uB3D9\uD5CC*\uC5D0\uC11C
    \uD558\uC2DC\uB294 \uAC83\uC774 \uBC95\uB3C4\uC774\uC635\uB2C8\uB2E4, \uC5B4\uC0AC\uB610."
