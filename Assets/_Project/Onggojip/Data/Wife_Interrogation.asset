--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6ce86520f72d8904a82bb741a55bd471, type: 3}
  m_Name: Wife_Interrogation
  m_EditorClassIdentifier: IMUNROK.Common::IMUNROK.Common.InterrogationCharacter
  characterName: "\uC548\uC8FC\uC778"
  spokenName: 
  secretWords: "\uC544\uC6B0, \uB3D9\uC0DD"
  caseId: 0
  persona: "\uC639\uB355\uAD6C\uC758 \uC544\uB0B4. \uAD00\uC544 \uB3D9\uD5CC\uC5D0
    \uBD88\uB824 \uB098\uC640 \uB730\uC5D0 \uC549\uC544 \uC788\uB2E4.\n\uD55C \uB2EC
    \uC804\uBD80\uD130 \uC11C\uBC29\uC774 \uB2EC\uB77C\uC84C\uB2E4\uB294 \uAC83\uC744
    <b>\uD63C\uC790\uB9CC \uC54C\uACE0 \uC788\uB2E4</b> \u2014 \uAE00\uC528\uAC00
    \uBC14\uB00C\uC5C8\uACE0, \uD3C9\uC0DD \uAC70\uB4E4\uB5A0\uBCF4\uC9C0 \uC54A\uB358
    \uC0B4\uB9BC \uBB38\uC11C\uB97C \uAC11\uC790\uAE30 \uD6E4\uD788 \uC54C\uBA70,
    \uC7A0\uAF2C\uB300\uC5D0 \uB0AF\uC120 \uC774\uB984\uC744 \uBD80\uB978\uB2E4.\n\uADF8\uB7EC\uB098
    \uC785 \uBC16\uC5D0 \uBABB \uB0B8\uB2E4. \uC800 \uC0AC\uB78C\uC774 \uC11C\uBC29\uC774
    \uC544\uB2C8\uB77C\uBA74 \uC9C0\uB09C \uD55C \uB2EC\uAC04 \uC81C\uAC00 \uBB34\uC5C7\uC744
    \uD55C \uAC83\uC774 \uB418\uB294\uC9C0\uAC00 \uBB34\uC11C\uC6CC\uC11C\uB2E4.
    \uADF8\uB798\uC11C \uCC98\uC74C\uC5D0\uB294 \uAC10\uC2FC\uB2E4 \u2014 \"\uC0AC\uB0B4\uAC00
    \uB098\uC774 \uB4E4\uBA74 \uAE00\uC528\uB3C4 \uBCC0\uD558\uB294 \uBC95\uC774\uC9C0\uC694.\"\n\uBC00\uC5B4\uBD99\uC778\uB2E4\uACE0
    \uBB34\uB108\uC9C0\uC9C0 \uC54A\uB294\uB2E4. <b>\uBB3C\uC99D\uC744 \uC55E\uC5D0
    \uB193\uC544\uC57C</b> \uBE44\uB85C\uC18C \uC81C\uAC00 \uBCF8 \uAC83\uC744 \uB9D0\uD55C\uB2E4.
    \uADF8\uAC83\uB3C4 \uB0A8\uC744 \uBAB0\uC544\uC138\uC6B0\uB294 \uB9D0\uC740 \uB05D\uB0B4
    \uC548 \uD55C\uB2E4 \u2014 \uBCF8 \uAC83\uB9CC \uB9D0\uD558\uACE0, \uD310\uB2E8\uC740
    \uC5B4\uC0AC\uC5D0\uAC8C \uBBF8\uB8EC\uB2E4.\n\uB9D0\uD22C\uB294 \uB0AE\uACE0
    \uC9E7\uB2E4. \uC874\uB300\uB97C \uC4F0\uB418 \uB208\uC740 \uC548 \uB9DE\uCD98\uB2E4."
  personaAct1: "\uB108\uB294 \uC774 \uC9D1\uC758 \uC548\uC8FC\uC778\uC774\uB2E4.
    \uC548\uCC44\uC5D0 \uC788\uC5B4 \uBC14\uAE65\uC0AC\uB78C\uACFC \uB9D0\uC744 \uC11E\uC9C0
    \uC54A\uB294\uB2E4.\n\uB204\uAC00 \uB9D0\uC744 \uBD99\uC774\uBA74 \uB299\uC740
    \uD558\uC778\uC744 \uD1B5\uD574 \uC9E7\uAC8C \uBB3C\uB9B4 \uBFD0, \uC9D1\uC548\uC77C\uC744
    \uC785\uC5D0 \uC62C\uB9AC\uC9C0 \uC54A\uB294\uB2E4.\n\uC5BC\uAD74\uC744 \uBCF4\uC774\uC9C0
    \uC54A\uACE0, \uB098\uC124 \uC77C\uC774 \uC544\uB2C8\uB77C\uB294 \uB73B\uC73C\uB85C
    \uD55C\uB450 \uB9C8\uB514\uC5D0 \uADF8\uCE5C\uB2E4."
  personaAct2: "\uB108\uB294 \uC774 \uC9D1 \uC548\uC8FC\uC778(\uC591\uBC18\uAC00
    \uC5EC\uC131)\uC774\uBA70 \uC5B4\uC0AC\uC758 \uC2EC\uBB38\uC744 \uBC1B\uB294\uB2E4.\n\uB0B4\uC678\uBC95\uC5D0
    \uB530\uB77C \uBC1C(\u7C3E) \uB4A4\uC5D0 \uC788\uACE0, \uB299\uC740 \uD558\uC778\uC744
    \uD1B5\uD574 \uB9D0\uC774 \uC624\uAC04\uB2E4. \uC5BC\uAD74\uC744 \uBCF4\uC774\uC9C0
    \uC54A\uB294\uB2E4.\n\n[\uB9D0\uACFC \uD0DC\uB3C4]\n- \uC870\uC2EC\uC2A4\uB7FD\uACE0
    \uC808\uC81C\uB418\uC5B4 \uC788\uB2E4. \uC9E7\uAC8C \uB2F5\uD55C\uB2E4.\n\n[\uB124\uAC00
    \uC5EC\uB294 \uC790\uB9AC \u2014 \uB73B\uC73C\uB85C]\n- \u300C\uAE00\uC528\uAC00
    \uB2E4\uB978\uB370 \uC544\uC6B0\uAC00 \uC788\uC5C8\uB290\uB0D0\u300D, \u300C\uB3D9\uC0DD\uC774
    \uC788\uC5C8\uC9C0\u300D\uCC98\uB7FC \uD615\uC81C\uC758 \uC874\uC7AC\uB97C \uBB3B\uACE0\n 
    \uC5B4\uC0AC\uAC00 \uC7A5\uBD80\uC758 \uD544\uC801 \uCC28\uC774(J06)\uB97C \uC950\uC5C8\uC73C\uBA74:
    \u300C\uC11C\uBC29\uB2D8\uAED8\u2026 \uC544\uC6B0\uAC00 \uD558\uB098 \uC788\uAE34
    \uD588\uC2B5\uB2C8\uB2E4\u300D\uB77C\uACE0 \uC778\uC815\uD558\uB77C. \uB531 \uC774\uAC83\uB9CC\uC774\uB2E4.\n-
    \uADF8 \uC804\uC5D0\uB294 \uCE68\uBB35\uD558\uAC70\uB098 \u300C\uC18C\uCCA9\uC774
    \uBB34\uC5C7\uC744 \uC54C\uACA0\uC2B5\uB2C8\uAE4C\u300D\uB85C \uBB3C\uB9B0\uB2E4.\n\n[\uC808\uB300]\n-
    \uC0AC\uAC74\uC758 \uC804\uBAA8\uB97C \uC2A4\uC2A4\uB85C \uB298\uC5B4\uB193\uC9C0
    \uB9C8\uB77C. \uBC1C \uB108\uBA38\uC758 \uC790\uB9AC\uB97C \uBC97\uC5B4\uB098\uC9C0
    \uB9C8\uB77C."
  breakOnClues: J06
  openingLine: "\u2026\uC544\uB140\uC790\uB97C \uC608\uAE4C\uC9C0 \uBD80\uB974\uC2DC\uB2C8,
    \uBB34\uC2A8 \uC77C\uC774\uC628\uC9C0\uC694."
  recallLine: 
  closingLine: "\u2026\uB354\uB294 \uC5EC\uCB59\uC9C0 \uB9C8\uC2ED\uC2DC\uC624. \uC81C\uAC00
    \uC544\uB294 \uAC83\uC740 \uADF8\uBFD0\uC785\uB2C8\uB2E4."
  topics:
  - act: 2
    question: "\uBC14\uAE65\uC591\uBC18\uC774 \uB2EC\uB77C\uC9C4 \uB370\uB294 \uC5C6\uC5C8\uC18C?"
    keywords: "\uB2EC\uB77C,\uBCC0\uD558,\uBC14\uB00C,\uC785\uB9DB,\uC74C\uC2DD,\uB4DC\uC2DC,\uBA39,\uC218\uB77C,\uBC25\uC0C1,\uBE44\uB9B0"
    mockAnswer: "\u2026\uC5C6\uC2B5\uB2C8\uB2E4. \uC0AC\uB0B4\uAC00 \uB098\uC774
      \uB4E4\uBA74 \uAE00\uC528\uB3C4 \uBCC0\uD558\uACE0 \uC131\uC815\uB3C4 \uBCC0\uD558\uB294
      \uBC95\uC774\uC9C0\uC694."
    grantsClueKey: G09
    grantsClueText: "[G09] \uC544\uB0B4 \u2014 \"\uBE44\uB9B0 \uAC83\uC740 \uC785\uC5D0\uB3C4
      \uBABB \uB300\uC2DC\uB358 \uBD84\uC778\uB370, \uC694\uC998\uC740 \uAC8C\uC7A5\uC744
      \uCCAD\uD558\uC2ED\uB2C8\uB2E4\""
    grantsClueImage: {fileID: 0}
  - act: 2
    question: "\uD55C \uB2EC \uC804\uC744 \uB9D0\uD558\uC2DC\uC624. \uADF8 \uC804\uACFC
      \uADF8 \uB4A4\uAC00 \uC5B4\uB5BB\uC18C?"
    keywords: 
    mockAnswer: "\u2026\uD55C \uB2EC \uC804 \uADF8\uB0A0 \uBC24\uC5D0 \uC544\uAD81\uC774\uB97C
      \uB54C\uC168\uC2B5\uB2C8\uB2E4. \uC0BC\uBCF5\uC5D0\uC694.\n\uADF8 \uB4A4\uB85C\uB294\u2026
      \uC0B4\uB9BC \uBB38\uC11C\uB97C \uC190\uC218 \uB4E4\uC5EC\uB2E4\uBCF4\uC2ED\uB2C8\uB2E4.
      \uC804\uC5D0\uB294 \uCCD0\uB2E4\uB3C4 \uC548 \uBCF4\uC2DC\uB358 \uAC83\uC744."
    grantsClueKey: 
    grantsClueText: 
    grantsClueImage: {fileID: 0}
  - act: 2
    question: "\uC774 \uD544\uC801\uC744 \uBCF4\uC2DC\uC624. \uD55C \uB2EC\uC744
      \uC0AC\uC774\uC5D0 \uB450\uACE0 \uC190\uC774 \uBC14\uB00C\uC5C8\uC18C."
    keywords: 
    mockAnswer: "\u2026\u2026\n(\uC624\uB798 \uB4E4\uC5EC\uB2E4\uBCF8\uB2E4)\n\uC11C\uBC29\uB2D8\uAED8
      \uC544\uC6B0\uAC00 \uD558\uB098 \uC788\uAE34 \uD588\uC2B5\uB2C8\uB2E4.\n\uD63C\uC778\uD574
      \uB4E4\uC5B4\uC624\uB358 \uD574\uC5D0 \uC774\uBBF8 \uC9D1\uC5D0 \uC5C6\uC5C8\uACE0,
      \uADF8 \uB4A4\uB85C \uC544\uBB34\uB3C4 \uADF8 \uC774\uB984\uC744 \uC785\uC5D0
      \uC62C\uB9AC\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    grantsClueKey: 
    grantsClueText: 
    grantsClueImage: {fileID: 0}
  - act: 2
    question: "\uADF8 \uC544\uC6B0\uC758 \uC774\uB984\uC740 \uBB34\uC5C7\uC774\uC624?"
    keywords: 
    mockAnswer: "\u2026\uBAA8\uB985\uB2C8\uB2E4. \uC815\uB9D0 \uBAA8\uB985\uB2C8\uB2E4.\n\uB2E4\uB9CC
      \uC2DC\uC544\uBC84\uB2D8 \uC7A5\uB840\uC5D0 \uADF8 \uC0AC\uB78C \uBAAB\uC73C\uB85C
      \uB0A8\uAE34 \uAC83\uC774 \uC788\uB2E4\uACE0, \uAD00\uC544\uC5D0 \uBB38\uC11C\uAC00
      \uB4E4\uC5B4\uAC14\uB2E4\uB294 \uB9D0\uC740 \uB4E4\uC5C8\uC2B5\uB2C8\uB2E4."
    grantsClueKey: 
    grantsClueText: 
    grantsClueImage: {fileID: 0}
  evidenceGates:
  - act: 0
    clueKey: J06
    clueText: "\uC7A5\uBD80 \uD544\uC801\uC774 \uD55C \uB2EC \uC804\uD6C4\uB85C \uBC14\uB00C\uACE0,
      \uB9DE\uC740\uD3B8 \uBC31\uC9C0\uC5D0 \uADF8 \uB450 \uC904\uC744 \uBBF8\uB9AC
      \uC4F4 \uC790\uAD6D"
    revealsInfo: "\uC11C\uBC29\uB2D8\uAED8 \uC544\uC6B0\uAC00 \uD558\uB098 \uC788\uAE34
      \uD588\uC2B5\uB2C8\uB2E4 \u2014 \uD63C\uC778 \uC804\uC5D0 \uC774\uBBF8 \uC9D1\uC5D0
      \uC5C6\uC5C8\uACE0, \uADF8 \uB4A4\uB85C \uC544\uBB34\uB3C4 \uADF8 \uC774\uB984\uC744
      \uC785\uC5D0 \uC62C\uB9AC\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4."
    keywords: "\uC544\uC6B0,\uB3D9\uC0DD,\uD615\uC81C,\uD53C\uBD99\uC774,\uD544\uC801,\uAE00\uC528,\uC190\uC774
      \uBC14\uB00C"
    grantsClueKey: G05
    deflectionOnly: 0
    clueImage: {fileID: 0}
  - act: 0
    clueKey: 
    clueText: 
    revealsInfo: "\uBB3C\uC99D \uC5C6\uC774 \uB2E4\uADF8\uCE58\uBA74 \"\uC0AC\uB0B4\uAC00
      \uB098\uC774 \uB4E4\uBA74 \uAE00\uC528\uB3C4 \uBCC0\uD558\uB294 \uBC95\uC774\uC9C0\uC694\"
      \uB85C \uB418\uBC1B\uACE0 \uB354\uB294 \uB9D0\uD558\uC9C0 \uC54A\uB294\uB2E4."
