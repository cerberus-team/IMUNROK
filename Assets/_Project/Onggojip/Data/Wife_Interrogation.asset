  - "\uC544\uB140\uC790\uAC00 \uB098\uC124 \uC77C\uC774 \uC544\uB2D9\uB2C8\uB2E4."
  mockDeflectAct2:
  - "\uC18C\uCCA9\uC774 \uBB34\uC5C7\uC744 \uC54C\uACA0\uC2B5\uB2C8\uAE4C."
  - "\u2026\u2026."
  - "\uBC14\uAE65\uC77C\uC740 \uC18C\uCCA9\uC774 \uC5EC\uCB50 \uC77C\uC774 \uC544\uB2C8\uC635\uB2C8\uB2E4."
  openingLine: "\u2026\uC544\uB140\uC790\uB97C \uC608\uAE4C\uC9C0 \uBD80\uB974\uC2DC\uB2C8,
    \uBB34\uC2A8 \uC77C\uC774\uC628\uC9C0\uC694."
  openingLineAct2: "\u2026\uBC1C \uB108\uBA38\uC5D0\uC11C \uC544\uB8B0\uC635\uB2C8\uB2E4.
    \uC5B4\uC0AC\uB610\uC758 \uBB3C\uC73C\uC2EC\uC774\uB2C8 \uB2F5\uD558\uACA0\uC0AC\uC624\uB098,
    \uC5BC\uAD74\uC740 \uB0B4\uBCF4\uC774\uC9C0 \uBABB\uD558\uC635\uB2C8\uB2E4."
  recallLine: 
  closingLine: "\u2026\uB354\uB294 \uC5EC\uCB59\uC9C0 \uB9C8\uC2ED\uC2DC\uC624. \uC81C\uAC00
    \uC544\uB294 \uAC83\uC740 \uADF8\uBFD0\uC785\uB2C8\uB2E4."
  closingLineAct2: "\u2026\uC18C\uCCA9\uC774 \uC544\uB294 \uAC83\uC740 \uADF8\uBFD0\uC774\uC635\uB2C8\uB2E4.
    \uC774\uB9CC \uBB3C\uB824 \uC8FC\uC2DC\uC635\uC18C\uC11C."
  closingLineUntilClue: 
  closingLineAfter: 
