  m_Script: {fileID: 11500000, guid: 6ce86520f72d8904a82bb741a55bd471, type: 3}
  m_Name: EulOng_Interrogation
  m_EditorClassIdentifier: IMUNROK.Common::IMUNROK.Common.InterrogationCharacter
  characterName: "\uC6EC \uC0AC\uB0B4"
  caseId: 0
  persona: "\uC790\uC2E0\uC774 \uC9C4\uC9DC \uC639\uB355\uAD6C\uB77C \uC8FC\uC7A5\uD558\uB294
    \uC0AC\uB0B4. \uC9D1\uC5D0\uC11C \uCAD3\uACA8\uB098 \uBBF8\uCE5C \uC0AC\uB78C
    \uCDE8\uAE09\uC744 \uBC1B\uB294\uB2E4. \uC5B5\uC6B8\uD558\uACE0 \uC808\uBC15\uD558\uAC8C
    \uC9C4\uC2E4\uC744 \uC678\uCE58\uC9C0\uB9CC \uC544\uBB34\uB3C4 \uBBFF\uC5B4\uC8FC\uC9C0
    \uC54A\uB294\uB2E4. \uB450\uC11C\uC5C6\uACE0 \uACA9\uC559\uB3FC \uC788\uB2E4."
  openingLine: "\uB0B4\uAC00! \uB0B4\uAC00 \uC9C4\uC9DC \uC639\uB355\uAD6C\uC694!
    \uC800 \uC548\uC5D0 \uC788\uB294 \uB188\uC740 \uAC00\uC9DC\uB780 \uB9D0\uC774\uC624!"
  closingLine: "\u2026\uD55C\uB370 \uC774 \uC0BC\uBCF5\uB354\uC704\uC5D0 \uC544\uAD81\uC774\uB294
    \uC65C \uB521\uB2E8 \uB9D0\uC774\uC624. \uB0B4\uAC00 \uC0B4 \uC801\uC5D4 \uC5EC\uB984\uC5D0
    \uBD88 \uD55C \uBC88 \uC548 \uB123\uC5C8\uC18C."
  topics:
  - question: "\uC9C4\uC815\uD558\uC2DC\uC624. \uBB34\uC2A8 \uC77C\uC774\uC624?"
    mockAnswer: "\uC800 \uB188\uC774 \uB0B4 \uC774\uB984, \uB0B4 \uC9D1, \uB0B4 \uCC98\uC790\uC2DD\uAE4C\uC9C0
      \uB2E4 \uBE7C\uC557\uC558\uC18C!"
    grantsClueKey: J01
    grantsClueText: "\u4E59\uC774 \uB9C8\uC744\uC5D0\uC11C \uBBF8\uCE5C \uC0AC\uB78C
      \uCDE8\uAE09\uC744 \uBC1B\uB294\uB2E4"
    grantsClueImage: {fileID: 0}
  - question: "\uC99D\uAC70\uAC00 \uC788\uC18C?"
    mockAnswer: "\uBB38\uC11C\uC694! \uBCC4\uAE09\uBB38\uAE30! \uD5CC\uB370 \uADF8\uB188\uC774\u2026
      \uB2E4 \uD0DC\uC6CC\uBC84\uB838\uC744 \uAC70\uC694!"
    grantsClueKey: 
    grantsClueText: 
    grantsClueImage: {fileID: 0}
  evidenceGates: []
