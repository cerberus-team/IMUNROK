    "\uBB3C\uC74C": "\uBB34\uC5C7\uC73C\uB85C \uADF8\uAC83\uC744 \uC544\uB294\uAC00.
      (\uCE90\uB0B8 \uAC83\uB9CC \uC4F8 \uC218 \uC788\uB2E4)"
    "\uBCF4\uAE30":
    - "\uB9D0": "\u7532\uC758 \uC67C\uD314\uC5D0 \uD30C\uAE30\uC640 \uAC19\uC740
        \uC790\uAD6D\uC774 \uC788\uC74C"
