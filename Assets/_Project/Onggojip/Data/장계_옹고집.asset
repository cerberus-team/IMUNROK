  - "\uC55E": "\uB610"
    "\uB4A4": "\uC740(\uB294) \uBA74\uCC9C\uB41C \uBAB8\uC774\uB098 \uBB38\uC11C\uAC00
      \uACE0\uCCD0\uC838 \uC544\uC9C1 \uC885\uC73C\uB85C \uC788\uC73C\uB2C8"
    "\uBB3C\uC74C": "\uC7A5\uBD80\uAC00 \uACE0\uCCD0\uC838 \uC2E0\uBD84\uC744 \uC783\uC740
      \uC790\uAC00 \uB204\uAD6C\uC778\uAC00."
