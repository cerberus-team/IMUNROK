  - "\uC55E": "\uB9C8\uB545\uD788"
    "\uB4A4": "\uD558\uC5EC\uC57C \uD560 \uAC83\uC774\uC635\uB2C8\uB2E4"
    "\uBB3C\uC74C": "\uC5B4\uCC0C \uCC98\uACB0\uD558\uC2DC\uB77C \uC544\uB8B8 \uAC83\uC778\uAC00."
    "\uBCF4\uAE30":
    - "\uB9D0": "\uAC00\uC9DC\uB97C \uB0B4\uCE58\uACE0 \uAC00\uC0B0\uC744 \uB3CC\uB824\uC8FC\uAC8C"
      "\uD544\uC694\uB2E8\uC11C": 
      "\uB9DE\uC74C": 1
      "\uD310\uACB0": 1
      "\uC410\uAE30": 0
    - "\uB9D0": "\uC0AC\uC815\uC744 \uD5E4\uC544\uB824 \uB9E4\uB97C \uAC10\uD558\uAC8C"
      "\uD544\uC694\uB2E8\uC11C": 
      "\uB9DE\uC74C": 1
      "\uD310\uACB0": 2
      "\uC410\uAE30": 0
    - "\uB9D0": "\uB458\uC744 \uB2E4 \uB450\uC5B4 \uD654\uBAA9\uCF00"
      "\uD544\uC694\uB2E8\uC11C": 
      "\uB9DE\uC74C": 0
      "\uD310\uACB0": 2
      "\uC410\uAE30": 0
  "\uB9FA\uC74C\uB9D0": "\uC0BC\uAC00 \uC544\uB8B0\uC635\uB098\uC774\uB2E4."
  "\uCC38\uB05D": "\uD30C\uAE30 \uD55C \uC904\uC774 \uC2A4\uBB34 \uD574\uB97C \uAC74\uB108
    \uC0AC\uB78C\uC744 \uC9DA\uC5C8\uB2E4. \uAC00\uC9DC\uB294 \uC639\uC9C4 \uBC16\uC73C\uB85C
    \uB0B4\uCCD0\uC84C\uACE0, \uC639\uB355\uAD6C\uB294 \uC81C \uC774\uB984\uC744
    \uB418\uCC3E\uC558\uB2E4. \uBCF5\uB3D9\uC740 \uADF8\uD574 \uAC00\uC744 <b>\uC81C
    \uC774\uB984\uC73C\uB85C</b> \uD638\uC801\uC5D0 \uC62C\uB790\uB2E4."
  "\uBC18\uB05D": "\uD310\uACB0\uC740 \uC130\uB2E4. \uB2E4\uB9CC <b>\uBABB \uBC15\uC744
    \uC99D\uC88C\uAC00 \uC5C6\uC5B4</b> \uC5C4\uD788 \uB2E4\uC2A4\uB9AC\uC9C0\uB294
    \uBABB\uD588\uB2E4. \uACE0\uC744\uC5D0\uB294 \uC544\uC9C1\uB3C4 \uC5B4\uB290
    \uCABD\uC774 \uCC38\uC774\uC5C8\uB290\uB0D0\uB294 \uB9D0\uC774 \uB0A8\uC558\uB2E4."
  "\uD5DB\uB05D": "\uAC00\uC9DC\uAC00 \uC639\uB355\uAD6C\uC758 \uC790\uB9AC\uC5D0
    \uADF8\uB300\uB85C \uC549\uC558\uB2E4. \uC9C4\uC9DC\uB294 \uC81C \uC9D1 \uBB38\uAC04\uC5D0\uC11C
    \uCAD3\uACA8\uB0AC\uACE0, \uBCF5\uB3D9\uC740 <b>\uC5EC\uD0DC \uC885\uC774\uB2E4</b>."
  "\uC774\uBB38\uB85D\uC904": "\uC639\uC9C4\uD604 \uC639\uACE0\uC9D1 \u2014 {\uD310\uACB0}"
