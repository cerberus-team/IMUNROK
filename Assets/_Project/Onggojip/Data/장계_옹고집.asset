    "\uC99D\uAC70\uAE30\uC900": 2
    "\uC99D\uAC70\uCD5C\uB300": 3
    "\uBCF4\uAE30":
    - "\uB9D0": "\uC0AC\uCE6D\uD55C \uBCF5\uB3D9\uC744 \uC5C4\uD788 \uB2E4\uC2A4\uB9AC\uACE0
        \uAC00\uC0B0\uC744 \uC639\uB355\uAD6C\uC5D0\uAC8C \uB3CC\uB824\uC8FC\uAC8C"
      "\uD544\uC694\uB2E8\uC11C": 
      "\uD310\uACB0": 1
      "\uC810\uC218": 2
    - "\uB9D0": "\uBCF5\uB3D9\uC758 \uBA74\uCC9C\uC744 \uB418\uC0B4\uB9AC\uACE0,
        \uC0AC\uCE6D\uC758 \uC8C4\uB294 \uC0AC\uC815\uC744 \uD5E4\uC544\uB824 \uAC10\uD558\uAC8C"
      "\uD544\uC694\uB2E8\uC11C": G11,G12
      "\uD310\uACB0": 2
      "\uC810\uC218": 2
    - "\uB9D0": "\uC131\uB09C \uC0AC\uB0B4\uB97C \uAD11\uC778\uC73C\uB85C \uB0B4\uCE58\uACE0
        \uC9C0\uAE08\uC758 \uC8FC\uC778\uC744 \uADF8\uB300\uB85C \uB450\uAC8C"
      "\uD544\uC694\uB2E8\uC11C": 
      "\uD310\uACB0": 3
      "\uC810\uC218": 0
    - "\uB9D0": "\uB450 \uC0AC\uB78C\uC744 \uB2E4 \uB450\uC5B4 \uC9D1\uC548\uC744
        \uD654\uBAA9\uCF00"
      "\uD544\uC694\uB2E8\uC11C": 
      "\uD310\uACB0": 3
      "\uC810\uC218": 0
    "\uB4A4": "\uD558\uC5EC\uC57C \uD560 \uAC83\uC774\uC635\uB2C8\uB2E4."
    "\uBB3C\uC74C": "\uC5B4\uCC0C \uCC98\uACB0\uD558\uC2DC\uB77C \uC544\uB8B8 \uAC83\uC778\uAC00."
    "\uD575\uC2EC": 0
    "\uAC11\uB9AC\uC904": 0
  "\uB9FA\uC74C\uB9D0": "\uC0BC\uAC00 \uC544\uB8B0\uC635\uB098\uC774\uB2E4."
  "\uC624\uB2F5\uAC10\uC810": 1
  "\uCC38\uAE30\uC900": 30
  "\uCC38\uB05D": "\uC0BC \uB144 \uC804 \uB300\uC7A5\uC5D0 \uC801\uD78C \uD30C\uAE30
    \uD55C \uC904\uC774 \uC0AC\uB78C\uC744 \uC9DA\uC5C8\uB2E4. \uBCF5\uB3D9\uC740
    \uC0AC\uCE6D\uC758 \uC8D7\uAC12\uC744 \uCE58\uB800\uACE0, \uC639\uB355\uAD6C\uB294
    \uC81C \uC774\uB984\uACFC \uAC00\uC0B0\uC744 \uB418\uCC3E\uC558\uB2E4. \uAC11\uB9AC\uC758
    \uC7A5\uBD80\uB3C4 \uBD88\uC0B4\uB77C\uC84C\uB2E4 \u2014 \uC639\uB2F9\uCD0C\uC5D0
    \uC639\uB355\uAD6C\uAC00 \uD558\uB098\uB85C \uB0A8\uB294\uB2E4."
  "\uBC18\uB05D": "\uD310\uACB0\uC740 \uC130\uB2E4. \uB2E4\uB9CC \uC7A5\uACC4\uC758
    \uBA87 \uC904\uC774 <b>\uC99D\uC88C\uB85C \uC11C\uC9C0 \uBABB\uD574</b> \uB05D\uAE4C\uC9C0
    \uB2E4\uC2A4\uB9AC\uC9C0\uB294 \uBABB\uD588\uB2E4. \uACE0\uC744\uC5D0\uB294 \uC544\uC9C1\uB3C4
    \uC5B4\uB290 \uCABD\uC774 \uCC38\uC774\uC5C8\uB290\uB0D0\uB294 \uB9D0\uC774 \uB0A8\uC558\uB2E4."
  "\uC790\uBE44\uB05D": "\uBCF5\uB3D9\uC758 \uBA74\uCC9C\uC774 \uB300\uC7A5\uC5D0
    \uB3C4\uB85C \uC62C\uB790\uB2E4. \uC0AC\uCE6D\uC758 \uC8C4\uB294 \uBB3C\uC5C8\uC73C\uB418
    \uB9E4\uB294 \uAC10\uD588\uB2E4 \u2014 \uC2A4\uBB34 \uD574 \uC885\uC73C\uB85C
    \uC801\uD600 \uC0B0 \uBAB8\uC774 \uC81C \uC774\uB984\uC744 \uCC3E\uAE30\uAE4C\uC9C0
    \uAC78\uB9B0 \uAE38\uC744 \uD5E4\uC544\uB9B0 \uAC83\uC774\uB2E4. \uC639\uB355\uAD6C\uB294
    \uAC00\uC0B0\uACFC \uD568\uAED8 \uAC11\uB9AC\uC758 \uBE5A\uB3C4 \uB3CC\uB824\uBC1B\uC558\uB2E4."
  "\uD5DB\uB05D": "\uAC00\uC9DC\uAC00 \uC639\uB355\uAD6C\uC758 \uC790\uB9AC\uC5D0
    \uADF8\uB300\uB85C \uC549\uC558\uB2E4. \uC9C4\uC9DC\uB294 \uC81C \uC9D1 \uBB38\uAC04\uC5D0\uC11C
    \uCAD3\uACA8\uB0AC\uACE0, \uBCF5\uB3D9\uC758 \uC774\uB984\uC740 <b>\uC5EC\uD0DC
    \uC8FD\uC740 \uC885</b>\uC73C\uB85C \uB0A8\uC558\uB2E4."
  "\uC774\uBB38\uB85D\uC904": "\uC639\uC9C4\uD604 \uC639\uACE0\uC9D1 \u2014 {\uB05D}"
