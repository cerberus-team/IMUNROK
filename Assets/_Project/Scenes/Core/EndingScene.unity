  _summaryTruthHeavy: "\uADF8\uB300\uB294 \uC774\uC57C\uAE30\uB97C \uAC77\uC5B4\uB0B4\uACE0
    \uC0AC\uC2E4\uB9CC\uC744 \uC887\uC558\uAD6C\uB098. \uB0C9\uC815\uD558\uB098,
    \uADF8\uAC83\uC774 \uAD6D\uBC95\uC774\uB2E4."
  _summaryMercyHeavy: "\uADF8\uB300\uB294 \uBC95 \uC55E\uC5D0\uC11C\uB3C4 \uC0AC\uB78C\uC758
    \uC0AC\uC815\uC744 \uBA3C\uC800 \uBCF4\uC558\uB2E4. \uBB34\uB974\uB098, \uC5B4\uC9C8\uB2E4
    \uD558\uACA0\uB2E4."
  _summaryFakeHeavy: "\uADF8\uB300\uB294 \uC124\uD654\uAC00 \uB36E\uC740 \uAC83\uC744
    \uADF8\uB300\uB85C \uB450\uC5C8\uB2E4. \uD3B8\uD558\uB098, \uADF8 \uC790\uB9AC\uC5D0
    \uC9C4\uC2E4\uC740 \uC5C6\uB2E4."
  _summaryMixed: "\uADF8\uB300\uC758 \uD310\uACB0\uC5D0\uB294 \uD558\uB098\uC758
    \uACB0\uC774 \uC5C6\uAD6C\uB098. \uC0AC\uC548\uB9C8\uB2E4 \uC800\uC6B8\uC774
    \uB2EC\uB790\uB2E4."
  _finalLine: "\uADF8\uB798\uC11C, \uADF8 \uC774\uC57C\uAE30\uB4E4\uC740 \uAC70\uC9D3\uC774\uC5C8\uB290\uB0D0."
  _worldToHide: {fileID: 799212141}
  _thanksLine: "\uD50C\uB808\uC774\uD574 \uC8FC\uC154\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4."
  _creditsLine: "\uC774\uBB38\uB85D (\u7570\u805E\u9304)\n\n\uD300\uC7A5  \uD568\uD55C\uC194     
    \uC81C2\uC0AC\uAC74 \xB7 \uC11C\uCC9C\uAF43\uBC2D   \uC804\uCCB4 \uAC1C\uBC1C\n\uD300\uC6D0 
    \uC774\uB958\uC9C4      \uC81C3\uC0AC\uAC74 \xB7 \uACAC\uC6B0\uC9C1\uB140   \uC804\uCCB4
    \uAC1C\uBC1C\n\uD300\uC6D0  \uC815\uC218\uBBFC      \uC81C1\uC0AC\uAC74 \xB7
    \uC639\uACE0\uC9D1\uC804   \uC804\uCCB4 \uAC1C\uBC1C \xB7 \uACF5\uD1B5 \uD30C\uD2B8"
  _hubSceneName: HubScene
  _autofillIfEmpty: 1
