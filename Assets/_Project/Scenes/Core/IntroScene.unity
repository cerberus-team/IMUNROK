    \uD558\uACE0, \uAF43\uC774 \uB418\uC0B4\uB838\uB2E4 \uD55C\uB2E4."
  - "\uB098\uB294 \uADF8 \uB9D0\uC744 \uBBFF\uC9C0 \uC54A\uB294\uB2E4."
  - "\uBD09\uC11C\uC640 \uB9C8\uD328, \uC720\uCC99\uC744 \uB0B4\uB9AC\uB2C8 \u2014
    \uAC00\uC11C \uBB34\uC5C7\uC774 \uC788\uC5C8\uB294\uC9C0 \uAE30\uB85D\uD574 \uC624\uB77C."
