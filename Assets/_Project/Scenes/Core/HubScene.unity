  _endWord: "{0}\uC744 \uC190\uC5D0 \uC775\uD614\uB2E4. \uC774\uC81C \uC5B8\uC81C\uB4E0
    \uAEBC\uB0B4 \uC4F8 \uC218 \uC788\uB2E4."
  _example: {fileID: 693705541}
  _practice: "\uC608\uC2DC\uB85C \uD55C \uC7A5 \uB4DC\uB9AC\uACA0\uC18C. \uB3CB\uBCF4\uAE30\uB97C
    \uB208\uC5D0 \uB300\uACE0(\uC624\uB978\uCABD \uB2E8\uCD94) \uAE00\uC790\uB97C
    \uD0A4\uC6CC \uBCF4\uC2DC\uC624."
  _practiceDone: "\uB410\uB2E4. \uC774\uB9CC\uD558\uBA74 {0}\uC740 \uC190\uC5D0 \uC775\uC5C8\uB2E4."
