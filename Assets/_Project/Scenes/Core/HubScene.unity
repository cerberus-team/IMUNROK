--- !u!114 &1945130462
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1945130461}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0f291c7182d5f474aad1fe64e309ce31, type: 3}
  m_Name: 
  m_EditorClassIdentifier: IMUNROK.Common::IMUNROK.Common.OwlGuide
  _speaker: "\uC18C\uCA4D\uC0C8"
  _stepWords:
  - when: 4
    lines:
    - "\uCC3D\uC774 \uBC1D\uC558\uC18C. \uBD09\uC11C\uD568\uC774 \uC5F4\uB838\uC73C\uB2C8,
      \uC774\uC81C \uC544\uB8B0\uB7EC \uAC08 \uB54C\uC694."
  - when: 1
    lines:
    - "\uC774\uBC88\uC5D0 \uBC1B\uC740 \uAC83\uB4E4\uC744 \uD55C \uBC88\uC529 \uAEBC\uB0B4
      \uBCF4\uC2DC\uC624. \uC190\uC5D0 \uB4E4\uC5B4\uC57C \uC544\uB294 \uBC95\uC774\uC624."
    - "\uBC1B\uC740 \uAC83\uC774 \uC0AC\uAC74\uB9C8\uB2E4 \uB2E4\uB974\uC624. \uC9C0\uB09C\uBC88\uC5D0
      \uC788\uB358 \uAC8C \uC774\uBC88\uC5D4 \uC5C6\uC744 \uC218\uB3C4 \uC788\uC18C."
  - when: 3
    lines:
    - "\uB2E4\uB140\uC654\uC73C\uBA74 \uAE30\uB85D\uB300\uC5D0 \uC549\uC73C\uC2DC\uC624.
      \uBA39\uC744 \uAC08\uACE0, \uBD93\uC744 \uB4E4\uACE0."
    - "\uC544\uC9C1 \uB9C8\uC74C\uC774 \uC548 \uC130\uAC70\uB4E0 \uC0AC\uAC74\uD310\uC744
      \uB2E4\uC2DC \uBCF4\uC2DC\uC624."
  - when: 2
    lines:
    - "\uC0AC\uAC74\uD310\uC5D0 \uC14B\uC774 \uAC78\uB824 \uC788\uC18C. \uC544\uBB34\uAC70\uB098
      \uBA3C\uC800 \uC7A1\uC73C\uC2DC\uC624 \u2014 \uCC28\uB840\uB294 \uC5C6\uC18C."
  - when: 0
    lines:
    - "\uC18C\uCA4D\u2026 \uB098\uB294 \uC544\uB294 \uAC8C \uC5C6\uC18C. \uBC1C\uB85C
      \uCC3E\uC73C\uC2DC\uC624."
  _toolWords:
  - toolId: journal
    lines:
    - "\uC218\uCCA9\uC774\uC624. \uBCF8 \uAC83\uC774 \uC800\uC808\uB85C \uC801\uD788\uC624.
      J \uB97C \uB204\uB974\uBA74 \uD3B4\uC9C0\uACE0, \uCCAB \uC7A5\uC5D0 \uC0AC\uAC74
      \uAC1C\uC694\uAC00 \uC788\uC18C."
  - toolId: map
    lines:
    - "\uC9C0\uB3C4\uC694. M \uC744 \uB204\uB974\uBA74 \uD3B4\uC9C0\uC624. \uC5B4\uB514\uB97C
      \uC544\uC9C1 \uC548 \uBC1F\uC558\uB294\uC9C0 \uBCF4\uC77C \uAC70\uC694."
  - toolId: lantern
    lines:
    - "\uB4F1\uBD88\uC774\uC624. \uB4E0 \uCC44\uB85C \uC5B4\uB450\uC6B4 \uB370\uB97C
      \uBCF4\uC2DC\uC624. \uC548 \uB4E4\uBA74 \uC544\uBB34\uAC83\uB3C4 \uC548 \uBCF4\uC774\uB294
      \uACF3\uC774 \uC788\uC18C."
  - toolId: magnify
    lines:
    - "\uB3CB\uBCF4\uAE30\uC694. \uC774\uAC78 \uB4E4\uACE0 \uBD10\uC57C \uBCF4\uC774\uB294
      \uAC83\uC774 \uB530\uB85C \uC788\uC18C. \uAE00\uC790\uB098 \uC790\uAD6D \uAC19\uC740
      \uAC83."
  _idleCall: "\uC18C\uCA4D\u2026 \uC18C\uCA4D\u2026"
  _idleEverySeconds: 55
  _idleWithin: 5
  _head: {fileID: 0}
  _turnSpeed: 3.5
